---
// src/pages/start.astro
// Landing page reached from the stickers' QR code and from social bios.
// Lives at /start with no language prefix: Astro i18n only governs [lang]/.
//
// The event block is NOT hardcoded. It is assembled in the browser from
// src/data/calendario.json, so a static build made weeks earlier still shows
// the right state on the day someone scans.

import calendario from '../data/calendario.json';

/** "DD/MM/YYYY" -> whole days since epoch (UTC). Null when the string is unusable. */
function toDay(value: unknown): number | null {
  const m = /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.exec(String(value ?? '').trim());
  if (!m) return null;
  const day = Number(m[1]);
  const month = Number(m[2]);
  const year = Number(m[3]);
  if (month < 1 || month > 12 || day < 1 || day > 31) return null;
  return Math.floor(Date.UTC(year, month - 1, day) / 86400000);
}

type RawEvent = {
  dataInizio?: string;
  dataFine?: string;
  titolo?: string;
  luogo?: string;
  tipo?: string;
  linkSchedule?: string;
  linkLivestream?: string;
};

// Only the fields the page needs, so the payload stays small.
const events = (calendario as RawEvent[])
  .map((e) => {
    const start = toDay(e.dataInizio);
    if (start === null) return null;
    const end = toDay(e.dataFine) ?? start; // single-day events may omit dataFine
    return {
      title: (e.titolo ?? '').trim(),
      place: (e.luogo ?? '').trim(),
      start,
      end: Math.max(start, end),
      live: (e.linkLivestream ?? '').trim(),
      schedule: (e.linkSchedule ?? '').trim(),
    };
  })
  .filter((e): e is NonNullable<typeof e> => e !== null && e.title !== '')
  .sort((a, b) => a.start - b.start);

const title = 'Reining Factory';
const description = 'Pedigrees, bloodlines, earnings and Hall of Fame. All reining in one place.';
const canonical = 'https://www.reiningfactory.com/start';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* A link hub has little text of its own: keep it out of the index so it
        never competes with the real pages, but let the links be followed. */}
    <meta name="robots" content="noindex, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#1a1408" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600&family=Barlow:wght@300;400&display=swap"
    />
  </head>

  <body>
    <main class="page">
      <div class="brand">
        <a class="home" href="/en/" id="home-logo">
          <img src="/immagini/logo.png" alt="Reining Factory" width="212" height="150" />
        </a>
        <p class="slogan">All reining in one place</p>
      </div>

      <div class="rule"></div>

      <section class="event" id="event" aria-label="Event" hidden>
        <div class="now">
          <span class="dot" id="dot" aria-hidden="true"></span>
          <span class="tag" id="tag"></span>
        </div>
        <h2 id="ev-name"><small id="ev-meta"></small></h2>
        <div class="stack" id="ev-links"></div>
      </section>

      <a class="primary" href="/en/" id="home-cta">Explore Reining Factory</a>

      <nav class="social" aria-label="Social">
        <a href="https://www.instagram.com/reiningfactory" aria-label="Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
        <a href="https://www.facebook.com/profile.php?id=61590167892858" aria-label="Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href="https://www.tiktok.com/@reiningfactory" aria-label="TikTok">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
        </a>
      </nav>

      <div class="spacer"></div>

      <footer>reiningfactory.com</footer>
    </main>

    <script type="application/json" id="rf-events" set:html={JSON.stringify(events)} is:inline
    ></script>

    <script>
      import { inject } from '@vercel/analytics';
      inject();
    </script>

    <script>
      type Ev = {
        title: string;
        place: string;
        start: number;
        end: number;
        live: string;
        schedule: string;
      };

      const LEAD = 7; // days before the start the block appears
      const TAIL = 5; // days after the end it stays, carrying results

      const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

      function readEvents(): Ev[] {
        const node = document.getElementById('rf-events');
        if (!node || !node.textContent) return [];
        try {
          const parsed = JSON.parse(node.textContent);
          return Array.isArray(parsed) ? (parsed as Ev[]) : [];
        } catch {
          return [];
        }
      }

      /** Compare whole UTC days, so the block never flips a day early or late
          for a visitor in another timezone.
          If the URL has ?d=YYYY-MM-DD that date is used instead (test override). */
      function today(): number {
        const params = new URLSearchParams(location.search);
        const d = params.get('d');
        if (d) {
          const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(d);
          if (m) {
            const ts = Date.UTC(+m[1], +m[2] - 1, +m[3]) / 86400000;
            if (!isNaN(ts)) return Math.floor(ts);
          }
        }
        const now = new Date();
        return Math.floor(
          Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) / 86400000
        );
      }

      function dateRange(start: number, end: number): string {
        const a = new Date(start * 86400000);
        const b = new Date(end * 86400000);
        const tail = `${b.getUTCDate()} ${MONTHS[b.getUTCMonth()]} ${b.getUTCFullYear()}`;
        if (start === end) return tail;
        return a.getUTCMonth() === b.getUTCMonth()
          ? `${a.getUTCDate()}–${tail}`
          : `${a.getUTCDate()} ${MONTHS[a.getUTCMonth()]} – ${tail}`;
      }

      type Hit = { ev: Ev; state: 'soon' | 'now' | 'done' };

      function pick(events: Ev[], day: number): Hit | null {
        let best: Hit | null = null;
        for (const ev of events) {
          if (day < ev.start - LEAD || day > ev.end + TAIL) continue;
          const state: Hit['state'] = day < ev.start ? 'soon' : day <= ev.end ? 'now' : 'done';
          // A running event always beats one that is merely approaching.
          if (!best || (state === 'now' && best.state !== 'now') || ev.start < best.ev.start) {
            best = { ev, state };
          }
        }
        return best;
      }

      function ghost(href: string, text: string, live = false): HTMLAnchorElement {
        const a = document.createElement('a');
        a.className = live ? 'ghost live' : 'ghost';
        a.href = href;
        a.textContent = text;
        a.rel = 'noopener';
        if (/^https?:/i.test(href)) a.target = '_blank';
        return a;
      }

      function render(): void {
        const section = document.getElementById('event');
        const dot = document.getElementById('dot');
        const tag = document.getElementById('tag');
        const name = document.getElementById('ev-name');
        const meta = document.getElementById('ev-meta');
        const links = document.getElementById('ev-links');
        if (!section || !dot || !tag || !name || !meta || !links) return;

        const hit = pick(readEvents(), today());
        if (!hit) {
          (section as HTMLElement).hidden = true;
          return;
        }

        const { ev, state } = hit;

        // Nothing useful to offer: don't show an empty panel.
        const hasLink = (state === 'now' && ev.live) || ev.schedule;
        if (!hasLink) {
          (section as HTMLElement).hidden = true;
          return;
        }

        const days = ev.start - today();
        tag.textContent =
          state === 'now'
            ? 'On now'
            : state === 'done'
              ? 'Just finished'
              : days <= 1
                ? 'Starts tomorrow'
                : `In ${days} days`;

        name.childNodes[0]?.nodeType === Node.TEXT_NODE
          ? (name.childNodes[0].nodeValue = ev.title + ' ')
          : name.insertBefore(document.createTextNode(ev.title + ' '), name.firstChild);

        meta.textContent = ev.place ? `${ev.place} · ${dateRange(ev.start, ev.end)}` : dateRange(ev.start, ev.end);

        links.textContent = '';
        if (state === 'now' && ev.live) links.appendChild(ghost(ev.live, 'Watch live', true));
        if (ev.schedule) {
          links.appendChild(ghost(ev.schedule, state === 'done' ? 'Results' : 'Schedule'));
        }

        section.setAttribute('data-state', state);
        (dot as HTMLElement).hidden = state !== 'now';
        (section as HTMLElement).hidden = false;
      }

      /** The page is English, but an Italian visitor is better served by /it/. */
      function localiseHomeLinks(): void {
        if (!/^it\b/i.test(navigator.language || '')) return;
        for (const id of ['home-logo', 'home-cta']) {
          const el = document.getElementById(id) as HTMLAnchorElement | null;
          if (el) el.href = '/it/';
        }
      }

      render();
      localiseHomeLinks();
    </script>

    <style is:global>
      /* Committed dark theme: the brand is dark-premium western.
         Gold is the only accent; the live red is semantic and appears once. */
      :root {
        --dark: #1a1408;
        --panel: #241c0e;
        --cream: #e8e0d0;
        --gold: #e0b05a;
        --sand: #d4b896;
        --live: #e8734f;
        --line: rgba(224, 176, 90, 0.2);
        --muted: rgba(232, 224, 208, 0.58);
        --label: 'Barlow Condensed', 'Arial Narrow', system-ui, sans-serif;
        --body: 'Barlow', system-ui, -apple-system, 'Helvetica Neue', sans-serif;
        color-scheme: dark;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
      }

      body {
        background:
          radial-gradient(120% 60% at 50% 0%, rgba(224, 176, 90, 0.12) 0%, rgba(224, 176, 90, 0) 58%),
          var(--dark);
        color: var(--cream);
        font-family: var(--body);
        font-weight: 300;
        display: flex;
        justify-content: center;
      }

      .page {
        width: 100%;
        max-width: 420px;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        gap: 26px;
        padding-block: calc(46px + env(safe-area-inset-top, 0px))
          calc(28px + env(safe-area-inset-bottom, 0px));
        padding-left: max(26px, env(safe-area-inset-left, 0px));
        padding-right: max(26px, env(safe-area-inset-right, 0px));
      }

      .brand {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
      }
      .home {
        display: block;
        line-height: 0;
      }
      .brand img {
        width: 212px;
        max-width: 100%;
        height: auto;
        display: block;
      }

      .slogan {
        margin: -34px 0 0;
        font-family: var(--label);
        font-weight: 600;
        font-size: 13px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--gold);
        text-align: center;
      }

      .rule {
        width: 46px;
        height: 1px;
        background: var(--gold);
        opacity: 0.45;
        margin-inline: auto;
      }

      .event {
        border: 1px solid var(--line);
        border-radius: 3px;
        background: var(--panel);
        padding: 15px 16px 16px;
        display: flex;
        flex-direction: column;
        gap: 13px;
      }
      .event[data-state='now'] {
        border-color: rgba(232, 115, 79, 0.4);
      }
      .event[data-state='done'] {
        border-color: rgba(232, 224, 208, 0.14);
      }

      .now {
        display: flex;
        align-items: center;
        gap: 7px;
      }
      .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--live);
        flex-shrink: 0;
        animation: pulse 2s ease-in-out infinite;
      }
      @keyframes pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.35;
        }
      }

      .now .tag {
        font-family: var(--label);
        font-weight: 600;
        font-size: 12px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--gold);
      }
      .event[data-state='now'] .now .tag {
        color: var(--live);
      }
      .event[data-state='done'] .now .tag {
        color: var(--muted);
      }

      .event h2 {
        margin: 0;
        font-family: var(--label);
        font-weight: 500;
        font-size: 19px;
        line-height: 1.22;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--cream);
        text-wrap: balance;
      }
      .event h2 small {
        display: block;
        font-size: 13px;
        letter-spacing: 0.12em;
        color: var(--muted);
        margin-top: 3px;
      }

      .ghost {
        display: block;
        text-decoration: none;
        border: 1px solid var(--line);
        border-radius: 3px;
        padding: 12px 14px;
        text-align: center;
        font-family: var(--label);
        font-weight: 600;
        font-size: 15px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--cream);
        transition:
          border-color 140ms ease,
          color 140ms ease;
      }
      .ghost:hover {
        border-color: var(--gold);
        color: var(--gold);
      }
      .ghost.live {
        border-color: rgba(232, 115, 79, 0.55);
        color: var(--live);
      }
      .ghost.live:hover {
        border-color: var(--live);
      }

      .stack {
        display: flex;
        flex-direction: column;
        gap: 9px;
      }

      .primary {
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        background: var(--gold);
        color: #1a1408;
        border-radius: 3px;
        padding: 17px 20px;
        font-family: var(--label);
        font-weight: 600;
        font-size: 17px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        text-align: center;
        transition: background 160ms ease;
      }
      .primary:hover {
        background: #eec074;
      }

      .social {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .social a {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border: 1px solid var(--line);
        border-radius: 14px;
        color: var(--sand);
        transition:
          border-color 140ms ease,
          color 140ms ease;
      }
      .social a:hover {
        border-color: var(--gold);
        color: var(--gold);
      }
      .social svg {
        width: 22px;
        height: 22px;
        display: block;
        fill: currentColor;
      }

      .spacer {
        flex: 1 1 auto;
        min-height: 8px;
      }

      footer {
        text-align: center;
        font-family: var(--label);
        font-size: 13px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: rgba(232, 224, 208, 0.4);
      }

      a:focus-visible {
        outline: 2px solid var(--gold);
        outline-offset: 3px;
      }

      @media (prefers-reduced-motion: reduce) {
        * {
          transition: none !important;
          animation: none !important;
        }
      }
    </style>
  </body>
</html>
