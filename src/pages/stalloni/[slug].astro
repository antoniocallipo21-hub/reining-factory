---
import { getCollection } from 'astro:content';
import StalloneLayout from '../../layouts/StalloneLayout.astro';
export async function getStaticPaths() {
  const stalloniEntries = await getCollection('stalloni');
  return stalloniEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const horse = entry.data;
// Mappatura nomi-slug per pedigree
const allStalloni = await getCollection('stalloni');
const horseMap = new Map(allStalloni.map(s => [s.data.name?.toUpperCase().trim(), s.id]));
function renderHorseName(name) {
  if (!name) return "-";
  const cleanName = name.toUpperCase().trim();
  const slug = horseMap.get(cleanName);
  if (slug) return `<a href="/stalloni/${slug}">${name}</a>`;
  return name;
}
// Split nome hero
const nameParts = (horse.name || "").toUpperCase().trim().split(' ');
const lastWord  = nameParts.length > 1 ? nameParts.pop() : "";
const firstPart = nameParts.join(' ');
// YouTube embed
function getYoutubeEmbed(url) {
  if (!url) return null;
  const match = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|embed\/)([a-zA-Z0-9_-]+)/);
  return match ? `https://www.youtube.com/embed/${match[1]}` : url;
}
const embedUrl = getYoutubeEmbed(horse.videoUrl);
---
<StalloneLayout title={`${horse.name} – Reining Factory`}>
  <style is:global>
    /* CSS ORIGINALE INTEGRALE */
    .hero {
      position: relative;
      height: 100vh;
      min-height: 600px;
      overflow: hidden;
      display: flex;
      align-items: flex-end;
      width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
    }
    .hero-gallery {
      position: absolute;
      inset: 0;
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      grid-template-rows: 1fr 1fr;
      gap: 3px;
    }
    .hero-gallery .main-img {
      grid-column: 1 / 3;
      grid-row: 1 / 3;
    }
    .hero-gallery img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: saturate(0.85);
    }
    .gallery-strip {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 1.5rem;
    }
    .gallery-thumb {
      width: 80px;
      height: 60px;
      object-fit: cover;
      cursor: pointer;
      opacity: 0.75;
      transition: opacity 0.2s, transform 0.2s;
      border: 1px solid var(--border);
    }
    .gallery-thumb:hover { opacity: 1; transform: scale(1.05); }
    .lightbox {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.92);
      z-index: 9999;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 1rem;
    }
    .lightbox.active { display: flex; }
    .lightbox img {
      max-width: 90vw;
      max-height: 80vh;
      object-fit: contain;
      border: 1px solid rgba(200,151,58,0.3);
    }
    .lightbox-close {
      position: absolute;
      top: 1.5rem;
      right: 2rem;
      color: white;
      font-size: 2rem;
      cursor: pointer;
      opacity: 0.7;
      background: none;
      border: none;
      line-height: 1;
    }
    .lightbox-close:hover { opacity: 1; }
    .lightbox-nav {
      display: flex;
      gap: 2rem;
    }
    .lightbox-nav button {
      background: none;
      border: 1px solid rgba(200,151,58,0.4);
      color: var(--gold);
      padding: 0.5rem 1.5rem;
      font-size: 0.72rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.2s;
    }
    .lightbox-nav button:hover { background: rgba(200,151,58,0.15); }
    .social-buttons {
      display: flex;
      gap: 0.75rem;
      margin-top: 1.5rem;
      flex-wrap: wrap;
    }
    .btn-social {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.6rem 1.2rem;
      font-size: 0.68rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      text-decoration: none;
      border: 1px solid var(--border);
      color: var(--dark);
      background: white;
      transition: border-color 0.2s, background 0.2s, color 0.2s;
    }
    .btn-social:hover {
      border-color: var(--gold);
      background: var(--gold);
      color: white;
    }
    .btn-social svg { width: 14px; height: 14px; flex-shrink: 0; }
    .hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to top,
        rgba(26,22,16,0.92) 0%,
        rgba(26,22,16,0.4) 50%,
        transparent 100%
      );
    }
    .hero-content {
      position: relative;
      z-index: 2;
      padding: 3rem 4rem;
      width: 100%;
    }
    .hero-badge {
      display: inline-block;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--gold);
      border: 1px solid var(--gold);
      padding: 0.35rem 0.9rem;
      margin-bottom: 1.2rem;
    }
    .hero-name {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(3.5rem, 8vw, 7rem);
      color: white;
      line-height: 0.9;
      letter-spacing: 0.03em;
      margin-bottom: 0.5rem;
    }
    .hero-name span {
      color: var(--gold);
    }
    .hero-subtitle {
      font-family: 'Playfair Display', serif;
      font-style: italic;
      font-size: 1.1rem;
      color: rgba(255,255,255,0.6);
      margin-bottom: 2rem;
    }
    .hero-stats {
      display: flex;
      gap: 3rem;
    }
    .hero-stat-value {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.8rem;
      color: var(--gold-light);
      line-height: 1;
    }
    .hero-stat-label {
      font-size: 0.65rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.45);
      margin-top: 0.2rem;
    }
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }
    .achievements {
      background: var(--dark);
      padding: 4rem 0;
      width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
    }
    .achievements-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }
    .section-label {
      font-size: 0.65rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 2rem;
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .section-label::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }
    .achievements-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 0;
      border: 1px solid rgba(200,151,58,0.2);
    }
    .achievement-item {
      padding: 1.5rem 2rem;
      border-right: 1px solid rgba(200,151,58,0.15);
      border-bottom: 1px solid rgba(200,151,58,0.15);
      display: flex;
      align-items: flex-start;
      gap: 1rem;
    }
    .achievement-item:last-child { border-right: none; }
    .achievement-year {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.4rem;
      color: var(--gold);
      min-width: 50px;
      line-height: 1;
    }
    .achievement-text {
      font-size: 0.82rem;
      color: rgba(255,255,255,0.7);
      line-height: 1.5;
      font-weight: 300;
    }
    .info-section {
      padding: 5rem 0;
    }
    .info-grid {
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 4rem;
      align-items: start;
    }
    .passport-card {
      background: white;
      border: 1px solid var(--border);
      padding: 2.5rem;
      position: relative;
    }
    .gallery-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 2rem;
    }
    .gallery-logo {
      width: clamp(100px, 12vw, 150px);
      height: auto;
      object-fit: contain;
      opacity: 1;
      margin-bottom: -0.5rem; /* Allineamento ottico con la label */
    }
    .passport-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0;
      width: 4px;
      height: 100%;
      background: var(--gold);
    }
    .passport-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.4rem;
      letter-spacing: 0.1em;
      color: var(--dark);
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--border);
    }
    .passport-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 0.65rem 0;
      border-bottom: 1px solid rgba(107,76,42,0.08);
    }
    .passport-row:last-child { border-bottom: none; }
    .passport-key {
      font-size: 0.65rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--warm-gray);
    }
    .passport-value {
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--dark);
      text-align: right;
    }
    .panel-section {
      margin-top: 2rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border);
    }
    .panel-title {
      font-size: 0.65rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--warm-gray);
      margin-bottom: 1rem;
    }
    .panel-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
    }
    .panel-item {
      display: flex;
      justify-content: space-between;
      font-size: 0.78rem;
      padding: 0.3rem 0;
    }
    .genetic-link {
      display: inline-block;
      margin-top: 1.5rem;
      font-size: 0.68rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--gold);
      text-decoration: none;
      border-bottom: 1px solid var(--gold);
      padding-bottom: 2px;
      transition: opacity 0.2s;
    }
    .genetic-link:hover { opacity: 0.6; }
    .panel-gene { color: var(--warm-gray); }
    .panel-result { color: #2E7D32; font-weight: 500; }
    .pedigree-section h3 {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.4rem;
      letter-spacing: 0.1em;
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--border);
    }
    .ped-overflow {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .ped-grid {
      display: grid;
      grid-template-columns: 1.4fr 36px 1.3fr 1.6fr;
      min-width: 620px;
      min-height: 280px;
      align-items: center;
      background: var(--dark);
      padding: 2.5rem 2rem;
      text-transform: uppercase;
      font-family: 'DM Sans', sans-serif;
    }
    .ped-horse {
      text-align: center;
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.1rem;
      letter-spacing: 0.08em;
      color: var(--gold);
      padding-right: 10px;
      line-height: 1.3;
    }
    .ped-bracket {
      width: 14px;
      height: 175px;
      border: 2px solid rgba(200,151,58,0.4);
      border-right: none;
      margin: auto;
    }
    .ped-parents {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      height: 205px;
      padding-left: 12px;
    }
    .ped-parent {
      font-size: 0.78rem;
      font-weight: 500;
      color: white;
      height: 30px;
      display: flex;
      align-items: center;
      letter-spacing: 0.04em;
    }
    .ped-parent a {
      color: white !important;
      text-decoration: none;
      border-bottom: 1px solid rgba(200,151,58,0.5);
      padding-bottom: 1px;
      transition: border-color 0.2s, color 0.2s;
    }
    .ped-parent a:hover {
      color: var(--gold) !important;
      border-color: var(--gold);
    }
    .ped-ancestors {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      height: 230px;
      padding-left: 16px;
    }
    .ped-grandunit {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .ped-small-bracket {
      width: 10px;
      height: 52px;
      border: 2px solid rgba(200,151,58,0.25);
      border-right: none;
      flex-shrink: 0;
    }
    .ped-grandnames {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      height: 52px;
    }
    .ped-grand {
      font-size: 0.68rem;
      color: var(--warm-gray);
      white-space: nowrap;
      letter-spacing: 0.03em;
    }
    /* Supporto link in ped-grand se dinamico */
    .ped-grand a { color: var(--warm-gray); text-decoration: none; border-bottom: 1px solid rgba(200,151,58,0.3); }
    .ped-grand a:hover { color: var(--gold); border-color: var(--gold); }
    .ped-fulllink {
      display: inline-block;
      margin-top: 1.5rem;
      font-size: 0.68rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--gold);
      text-decoration: none;
      border-bottom: 1px solid var(--gold);
      padding-bottom: 2px;
      transition: opacity 0.2s;
    }
    .ped-fulllink:hover { opacity: 0.6; }
    .video-section {
      background: var(--dark);
      padding: 5rem 0;
      width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
    }
    .video-wrapper {
      position: relative;
      padding-bottom: 56.25%;
      height: 0;
      overflow: hidden;
      border: 1px solid rgba(200,151,58,0.2);
    }
    .video-wrapper iframe {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
    }
    .video-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 2rem;
    }
    .video-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 2rem;
      color: white;
      letter-spacing: 0.05em;
    }
    .offspring-section {
      padding: 5rem 0;
      background: white;
      width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
    }
    .offspring-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 3rem;
    }
    .offspring-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 2rem;
      letter-spacing: 0.05em;
    }
    .offspring-count {
      font-family: 'Playfair Display', serif;
      font-style: italic;
      color: var(--warm-gray);
      font-size: 0.9rem;
    }
    .offspring-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1px;
      background: var(--border);
      border: 1px solid var(--border);
    }
    .offspring-item {
      background: white;
      padding: 1.2rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: background 0.2s;
    }
    .offspring-item:hover { background: var(--cream); }
    .offspring-name {
      font-size: 0.82rem;
      font-weight: 500;
      letter-spacing: 0.03em;
    }
    .offspring-earnings {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1rem;
      color: var(--gold);
      letter-spacing: 0.05em;
    }
    .offspring-link {
      display: block;
      text-align: right;
      margin-top: 2rem;
      font-size: 0.72rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--gold);
      text-decoration: none;
      border-bottom: 1px solid var(--gold);
      padding-bottom: 2px;
      display: inline-block;
    }
    .breeding-section {
      padding: 5rem 0;
      background: var(--cream);
      width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
    }
    .breeding-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 2rem;
      margin-top: 2rem;
    }
    .breeding-card {
      border: 1px solid var(--border);
      padding: 2rem;
      background: white;
      transition: border-color 0.2s, transform 0.2s;
    }
    .breeding-card:hover {
      border-color: var(--gold);
      transform: translateY(-2px);
    }
    .breeding-card-label {
      font-size: 0.62rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--warm-gray);
      margin-bottom: 0.5rem;
    }
    .breeding-card-value {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.8rem;
      color: var(--dark);
      letter-spacing: 0.05em;
    }
    .breeding-card-sub {
      font-size: 0.78rem;
      color: var(--warm-gray);
      margin-top: 0.3rem;
    }
    .breeding-links {
      margin-top: 3rem;
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
    }
    .btn-primary {
      display: inline-block;
      padding: 0.9rem 2rem;
      background: var(--dark);
      color: var(--gold);
      font-size: 0.72rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      text-decoration: none;
      border: 1px solid var(--dark);
      transition: background 0.2s, color 0.2s;
    }
    .btn-primary:hover {
      background: var(--gold);
      color: var(--dark);
      border-color: var(--gold);
    }
    .btn-outline {
      display: inline-block;
      padding: 0.9rem 2rem;
      background: transparent;
      color: var(--dark);
      font-size: 0.72rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      text-decoration: none;
      border: 1px solid var(--dark);
      transition: background 0.2s, color 0.2s;
    }
    .btn-outline:hover {
      background: var(--dark);
      color: white;
    }
    @media (max-width: 768px) {
      .hero { height: 85vh; min-height: 500px; }
      .hero-content { padding: 1.5rem; }
      .hero-name { font-size: 3rem; }
      .hero-subtitle { font-size: 0.9rem; }
      .hero-stats { gap: 1.2rem; }
      .hero-stat-value { font-size: 1.4rem; }
      .hero-stat-label { font-size: 0.6rem; }
      .hero-badge { font-size: 0.6rem; }
      .hero-gallery { grid-template-columns: 1fr; grid-template-rows: 1fr; }
      .hero-gallery .main-img { grid-column: 1; grid-row: 1; }
      .hero-gallery img:not(.main-img img) { display: none; }
      .achievements { padding: 2.5rem 0; }
      .achievements-grid { grid-template-columns: 1fr; }
      .achievement-item { border-right: none; }
      .gallery-thumb { width: 70px; height: 55px; }
      .info-section { padding: 3rem 0; }
      .info-grid { grid-template-columns: 1fr; gap: 2.5rem; }
      .passport-card { padding: 1.5rem; }
      .passport-row { flex-direction: column; gap: 0.2rem; }
      .passport-value { text-align: left; }
      .social-buttons { flex-direction: column; }
      .btn-social { justify-content: center; }
      .ped-overflow { width: 100%; overflow-x: scroll; -webkit-overflow-scrolling: touch; }
      .ped-grid { min-width: 560px; padding: 1.5rem 1rem; }
      .video-section { padding: 3rem 0; }
      .video-header { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
      .offspring-section { padding: 3rem 0; }
      .offspring-header { flex-direction: column; align-items: flex-start; gap: 0.3rem; }
      .offspring-list { grid-template-columns: 1fr; }
      .breeding-section { padding: 3rem 0; }
      .breeding-grid { grid-template-columns: 1fr 1fr; gap: 1rem; }
      .breeding-links { flex-direction: column; }
      .btn-primary, .btn-outline { text-align: center; }
      .container { padding: 0 1.2rem; }
      .achievements-inner { padding: 0 1.2rem; }
    }
    .fade-in { opacity: 0; transform: translateY(20px); animation: fadeIn 0.7s ease forwards; }
    @keyframes fadeIn { to { opacity: 1; transform: translateY(0); } }
    .delay-1 { animation-delay: 0.1s; }
    .delay-2 { animation-delay: 0.2s; }
    .delay-3 { animation-delay: 0.35s; }
  </style>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-gallery">
      <div class="main-img">
        <img src={horse.mainImage} alt={horse.name}>
      </div>
      {horse.heroImages?.[0] && <img src={horse.heroImages[0]} alt="">}
      {horse.heroImages?.[1] && <img src={horse.heroImages[1]} alt="">}
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      {horse.badge && <div class="hero-badge fade-in">{horse.badge}</div>}
      <h1 class="hero-name fade-in delay-1">{firstPart}<br><span>{lastWord}</span></h1>
      <p class="hero-subtitle fade-in delay-2">{horse.nickname ? `"${horse.nickname}" · ` : ''}{horse.yearOfBirth} · {horse.color} · {horse.breed}</p>
      <div class="hero-stats fade-in delay-3">
        {horse.stats?.earnings && (
          <div>
            <div class="hero-stat-value">{horse.stats.earnings}</div>
            <div class="hero-stat-label">NRHA Lifetime Earnings</div>
          </div>
        )}
        {horse.stats?.sireRecord && (
          <div>
            <div class="hero-stat-value">{horse.stats.sireRecord}</div>
            <div class="hero-stat-label">Sire Record</div>
          </div>
        )}
        <div>
          <div class="hero-stat-value">{horse.yearOfBirth}</div>
          <div class="hero-stat-label">Anno di nascita</div>
        </div>
      </div>
    </div>
  </section>
  <!-- ACHIEVEMENTS -->
  {horse.achievements && horse.achievements.length > 0 && (
    <section class="achievements">
      <div class="achievements-inner">
        <div class="section-label">Palmares</div>
        <div class="achievements-grid">
          {horse.achievements.map((item) => (
            <div class="achievement-item">
              <div class="achievement-year">{item.year}</div>
              <div class="achievement-text">{item.title}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
  <!-- GALLERY -->
  {horse.gallery && horse.gallery.length > 0 && (
    <section style="background: var(--cream); padding: 5rem 0 3rem;">
      <div class="container">
        <div class="gallery-header">
          <div class="section-label">Galleria</div>
          {horse.logo && <img src={horse.logo} alt={`Logo ${horse.name}`} class="gallery-logo" />}
        </div>
        <div class="gallery-strip">
          {horse.gallery.map((img, index) => (
            <img class="gallery-thumb" src={img} alt="" onclick={`window.openLightbox(${index})`}>
          ))}
        </div>
      </div>
    </section>
  )}
  <!-- LIGHTBOX -->
  <div class="lightbox" id="lightbox" onclick="window.closeLightbox(event)">
    <button class="lightbox-close" onclick="window.closeLightbox()">×</button>
    <img id="lightbox-img" src="" alt="">
    <div class="lightbox-nav">
      <button onclick="window.changeLightbox(-1); event.stopPropagation()">← Prev</button>
      <button onclick="window.changeLightbox(1); event.stopPropagation()">Next →</button>
    </div>
  </div>
  <!-- PASSPORT + PEDIGREE -->
  <section class="info-section">
    <div class="container">
      <div class="info-grid">
        <!-- PASSPORT -->
        <div>
          <div class="passport-card">
            <div class="passport-title">Stallion Passport</div>
            <div class="passport-row"><span class="passport-key">Nome completo</span><span class="passport-value">{horse.name}</span></div>
            <div class="passport-row"><span class="passport-key">Razza</span><span class="passport-value">{horse.breed}</span></div>
            <div class="passport-row"><span class="passport-key">Mantello</span><span class="passport-value">{horse.color}</span></div>
            <div class="passport-row"><span class="passport-key">Anno di nascita</span><span class="passport-value">{horse.yearOfBirth}</span></div>
            <div class="passport-row"><span class="passport-key">Altezza</span><span class="passport-value">{horse.height}</span></div>
            <div class="passport-row"><span class="passport-key">Proprietario</span><span class="passport-value">{horse.owner}</span></div>
            <div class="passport-row"><span class="passport-key">Standing at</span><span class="passport-value">{horse.location}</span></div>
            {horse.geneticTest && (
              <div class="panel-section">
                <div class="panel-title">6 Panel Genetic Test</div>
                <div class="panel-grid">
                  {Object.entries(horse.geneticTest).map(([gene, res]) => (
                    <div class="panel-item"><span class="panel-gene">{gene.toUpperCase()}</span><span class="panel-result">{res}</span></div>
                  ))}
                </div>
                {horse.geneticCertificateUrl && (
                  <a href={horse.geneticCertificateUrl} target="_blank" class="genetic-link">CERTIFICATO GENETICO →</a>
                )}
              </div>
            )}
            <div class="social-buttons">
              {horse.social?.instagram && (<a href={horse.social.instagram} target="_blank" class="btn-social"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>Instagram</a>)}
              {horse.social?.facebook && (<a href={horse.social.facebook} target="_blank" class="btn-social"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>Facebook</a>)}
              {horse.social?.website && (<a href={horse.social.website} target="_blank" class="btn-social"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>Sito ufficiale</a>)}
            </div>
          </div>
        </div>
        <!-- PEDIGREE -->
        <div class="pedigree-section">
          <h3>Pedigree</h3>
          <div class="ped-overflow">
            <div class="ped-grid">
              <div class="ped-horse">{horse.name}</div>
              <div class="ped-bracket"></div>
              <div class="ped-parents">
                <div class="ped-parent" set:html={renderHorseName(horse.pedigree?.sire)}></div>
                <div class="ped-parent" set:html={renderHorseName(horse.pedigree?.dam)}></div>
              </div>
              <div class="ped-ancestors">
                <div class="ped-grandunit"><div class="ped-small-bracket"></div><div class="ped-grandnames"><div class="ped-grand" set:html={renderHorseName(horse.pedigree?.grandsire_sire)}></div><div class="ped-grand" set:html={renderHorseName(horse.pedigree?.grandsire_dam)}></div></div></div>
                <div class="ped-grandunit"><div class="ped-small-bracket"></div><div class="ped-grandnames"><div class="ped-grand" set:html={renderHorseName(horse.pedigree?.granddam_sire)}></div><div class="ped-grand" set:html={renderHorseName(horse.pedigree?.granddam_dam)}></div></div></div>
              </div>
            </div>
          </div>
          {horse.pedigreeUrl && <a href={horse.pedigreeUrl} target="_blank" class="ped-fulllink">Pedigree completo →</a>}
        </div>
      </div>
    </div>
  </section>
  <!-- VIDEO -->
  {embedUrl && (
    <section class="video-section">
      <div class="container">
        <div class="video-header"><div class="section-label" style="color:rgba(200,151,58,0.6); margin:0;">Video</div><div class="video-title" style="color:white;">In Arena</div></div>
        <div class="video-wrapper"><iframe src={embedUrl} title={horse.name} frameborder="0" allowfullscreen></iframe></div>
      </div>
    </section>
  )}
  <!-- OFFSPRING -->
  {horse.offspring && horse.offspring.length > 0 && (
    <section class="offspring-section">
      <div class="container">
        <div class="offspring-header">
          <div class="offspring-title">Figli in Evidenza</div>
          {horse.stats?.sireRecord && <div class="offspring-count">Sire record: {horse.stats.sireRecord}</div>}
        </div>
        <div class="offspring-list">
          {horse.offspring.map(off => (
            <div class="offspring-item"><span class="offspring-name">{off.name}</span><span class="offspring-earnings">{off.earnings}</span></div>
          ))}
        </div>
        <a href={horse.pedigreeUrl || "#"} target="_blank" class="offspring-link">Tutti gli offspring →</a>
      </div>
    </section>
  )}
  <!-- BREEDING -->
  <section class="breeding-section">
    <div class="container">
      <div class="section-label">Breeding Info</div>
      <div class="breeding-grid">
        <div class="breeding-card"><div class="breeding-card-label">Stud Fee</div><div class="breeding-card-value">{horse.breeding?.fee}</div><div class="breeding-card-sub">Per monta</div></div>
        <div class="breeding-card"><div class="breeding-card-label">Tipo Seme</div><div class="breeding-card-value">{horse.breeding?.semenType}</div><div class="breeding-card-sub">{horse.breeding?.semenNotes}</div></div>
        <div class="breeding-card"><div class="breeding-card-label">Stato</div><div class="breeding-card-value">{horse.breeding?.status}</div><div class="breeding-card-sub">{horse.breeding?.statusNotes}</div></div>
      </div>
      <div class="breeding-links">
        {horse.breedingLinks?.map(l => (
          <a href={l.url} target="_blank" class={l.primary ? "btn-primary" : "btn-outline"}>{l.label} →</a>
        ))}
      </div>
    </div>
  </section>
  <script is:inline define:vars={{ galleryImages: horse.gallery || [] }}>
    let currentIndex = 0;
    window.openLightbox = (index) => {
      currentIndex = index;
      document.getElementById('lightbox-img').src = galleryImages[index];
      document.getElementById('lightbox').classList.add('active');
      document.body.style.overflow = 'hidden';
    };
    window.closeLightbox = (e) => {
      if (!e || e.target.id === 'lightbox' || e.target.classList.contains('lightbox-close')) {
        document.getElementById('lightbox').classList.remove('active');
        document.body.style.overflow = '';
      }
    };
    window.changeLightbox = (dir) => {
      currentIndex = (currentIndex + dir + galleryImages.length) % galleryImages.length;
      document.getElementById('lightbox-img').src = galleryImages[currentIndex];
    };
  </script>
</StalloneLayout>