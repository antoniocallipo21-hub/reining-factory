    <div class="container">
      <div class="info-grid">
        <!-- PASSPORT -->
        <div style="min-width: 0;">
          <div class="passport-card">
            <div class="passport-title">Stallion Passport</div>
            <div class="passport-row"><span class="passport-key">{t('horse.name')}</span><span class="passport-value">{horse.name}</span></div>
            <div class="passport-row"><span class="passport-key">{t('horse.breed')}</span><span class="passport-value">{horse.breed}</span></div>
            <div class="passport-row"><span class="passport-key">{t('horse.color')}</span><span class="passport-value">{horse.color}</span></div>
            <div class="passport-row">
              <span class="passport-key">{t('horse.born')}</span>
              <span class="passport-value">{horse.yearOfBirth}{horse.yearOfDeath ? ` – ${horse.yearOfDeath}` : ''}</span>
            </div>
            <div class="passport-row"><span class="passport-key">{t('horse.height')}</span><span class="passport-value">{isEn ? (horse.height_en || horse.height) : horse.height}</span></div>
            <div class="passport-row"><span class="passport-key">{t('horse.owner')}</span><span class="passport-value">{horse.owner}</span></div>
