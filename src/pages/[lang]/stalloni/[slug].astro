    .breeding-section {
      padding: 5rem 0;
      background: var(--cream);
    }

    .breeding-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 2rem;
      margin-top: 2rem;
    }

    .breeding-card {
      border: 1px solid var(--border);
      padding: 2rem;
      background: white;
      transition: border-color 0.2s, transform 0.2s;
    }

    .breeding-card:hover {
      border-color: var(--gold);
      transform: translateY(-2px);
    }

    .breeding-card-label {
      font-size: 0.62rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--warm-gray);
      margin-bottom: 0.5rem;
    }

    .breeding-card-value {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.8rem;
      color: var(--dark);
      letter-spacing: 0.05em;
    }

    .breeding-card-sub {
      font-size: 0.78rem;
      color: var(--warm-gray);
      margin-top: 0.3rem;
    }

    .breeding-links {
      margin-top: 3rem;
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
    }

    .btn-primary {
      display: inline-block;
      padding: 0.9rem 2rem;
      background: var(--dark);
      color: var(--gold);
      font-size: 0.72rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      text-decoration: none;
      border: 1px solid var(--dark);
      transition: background 0.2s, color 0.2s;
    }

    .btn-primary:hover {
      background: var(--gold);
      color: var(--dark);
      border-color: var(--gold);
    }

    .btn-outline {
      display: inline-block;
      padding: 0.9rem 2rem;
      background: transparent;
      color: var(--dark);
      font-size: 0.72rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      text-decoration: none;
      border: 1px solid var(--dark);
      transition: background 0.2s, color 0.2s;
    }

    .btn-outline:hover {
      background: var(--dark);
      color: white;
    }

    @media (max-width: 768px) {
       .hero { height: 85vh; min-height: 500px; }
       .hero-content { padding: 140px 1.5rem 1rem 1.5rem; } /* Ottimizzato padding */
      .hero-name { 
        font-size: clamp(2rem, 11vw, 3.2rem); 
        overflow-wrap: anywhere; 
        word-wrap: break-word; 
      }
      .hero-subtitle { font-size: 0.9rem; }
      .hero-stats { gap: 1.2rem; }
      .hero-stat-value { font-size: 1.4rem; }
      .hero-stat-label { font-size: 0.6rem; }
      .hero-badge { font-size: 0.6rem; }

      .hero-gallery { grid-template-columns: 1fr; grid-template-rows: 1fr; }
      .hero-gallery .main-img { grid-column: 1; grid-row: 1; }
      .hero-gallery img:not(.main-img img) { display: none; }

      .achievements { padding: 2.5rem 0; }
      .achievements-grid { grid-template-columns: 1fr; }
      .achievement-item { border-right: none; }

      .gallery-thumb { width: 70px; height: 55px; }

      .info-section { padding: 3rem 0; }
      .info-grid { grid-template-columns: 1fr; gap: 2.5rem; }      /* Fix Passaporto Tagliato */
      .passport-card { padding: 1.2rem; width: 100%; max-width: 100%; box-sizing: border-box; }
      .passport-title { font-size: 1.2rem; margin-bottom: 1.5rem; }

      .social-buttons { flex-direction: column; }
      .btn-social { justify-content: center; }

      /* Ripristino dello Scroll Orizzontale Forzato per il Pedigree */
      .pedigree-section .container { padding: 0 1rem; max-width: 100vw; overflow: visible; }
      .pedigree-section h3 { padding: 0; }
      .ped-overflow { 
        width: 100%; 
        display: block;
        overflow-x: auto; 
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch; 
        padding: 0 0 1.5rem 0; 
        margin: 0;
      }
      .ped-overflow::-webkit-scrollbar {
        height: 6px;
      }
      .ped-overflow::-webkit-scrollbar-thumb {
        background: rgba(200,151,58,0.5);
        border-radius: 4px;
      }
      .ped-grid { 
        min-width: 600px; 
        padding: 1.5rem 1.5rem; 
        /* Reset alle colonne predefinite non ristrette */
        grid-template-columns: 1.4fr 36px 1.3fr 1.6fr;
      }
      .ped-horse { font-size: 1rem; white-space: normal; }
      .ped-parent { font-size: 0.78rem; white-space: nowrap; }
      .ped-grand { font-size: 0.68rem; white-space: nowrap; }

      .video-section { padding: 3rem 0; }
      .video-header { flex-direction: column; align-items: flex-start; gap: 0.5rem; }

      .offspring-section { padding: 3rem 0; }
      .offspring-header { flex-direction: column; align-items: flex-start; gap: 0.3rem; }
      .offspring-list { grid-template-columns: 1fr; }

      .breeding-section { padding: 3rem 0; }
      .breeding-grid { grid-template-columns: 1fr 1fr; gap: 1rem; }
      .breeding-links { flex-direction: column; }
      .btn-primary, .btn-outline { text-align: center; }
      
      /* Genetic tests status colors */
      .panel-result.status-green {
        color: #4ade80 !important;
      }
      .panel-result.status-red {
        color: #f87171 !important;
        font-weight: 700;
      }

      .container { padding: 0 1.2rem; }
      .achievements-inner { padding: 0 1.2rem; }
    }


    .siblings-disclaimer {
      margin-top: 1.5rem;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 0.8rem;
      letter-spacing: 0.1em;
      color: rgba(154,145,136,0.8);
      text-transform: uppercase;
    }
    .siblings-label {
      color: var(--db-gold);
      font-weight: 600;
      margin-right: 0.5rem;
    }
    .sibling-link {
      color: var(--db-gold);
      text-decoration: none;
      transition: opacity 0.2s;
    }
    .sibling-link:hover {
      opacity: 0.7;
    }
    .sibling-text {
      color: var(--db-gold);
    }
  </style>

  <div class="stallone-wrap">
    <!-- HERO -->
    <section class="hero">
    <div class="hero-gallery">
      <div class="main-img">
        <img src={horse.mainImage} alt={horse.name}>
      </div>
      {horse.heroImages?.[0] && <div class="side-img"><img src={horse.heroImages[0]} alt=""></div>}
      {horse.heroImages?.[1] && <div class="side-img"><img src={horse.heroImages[1]} alt=""></div>}
    </div>
    <div class="hero-overlay"></div>

    <div class="hero-content">
      {(() => {
        const bHero = isEn ? (horse.badge_hero_en || horse.badge_hero || horse.badge_en) : (horse.badge_hero || horse.badge);
        if (!bHero) return null;
        // Mostriamo tutti i titoli nell'header hero, separati da '·'
        return (
          <div class="hero-badges-wrap">
            {bHero.split('·').map(b => (
              <div class="hero-badge">{b.trim().toUpperCase()}</div>
            ))}
          </div>
        );
      })()}
      <h1 class="hero-name">
        {firstPart}
        {needsBr ? <br /> : (lastWord ? ' ' : '')}
        {lastWord && <span>{lastWord}</span>}
      </h1>
      <p class="hero-subtitle">
        {(isEn && horse.nickname_en) ? `"${horse.nickname_en}" · ` : (horse.nickname ? `"${horse.nickname}" · ` : '')}
        {horse.yearOfBirth}{horse.yearOfDeath ? ` – ${horse.yearOfDeath}` : ''} · {isEn ? (horse.color_en || horse.color) : horse.color} · {horse.breed}
      </p>
      <div class="hero-stats">
        {horse.stats?.earnings && (
          <div>
            <div class="hero-stat-value">
              {horse.stats.earnings.endsWith('+') ? horse.stats.earnings : `${horse.stats.earnings}+`}
            </div>
            <div class="hero-stat-label">NRHA Lifetime Earnings</div>
          </div>
        )}
        {(horse.stats?.sireRecord || horse.stats?.offspringEarnings) && (
          <div>
            <div class="hero-stat-value">
              {horse.stats.sireRecord 
                ? (horse.stats.sireRecord.toLowerCase() === 'counting' 
                   ? (isEn ? 'Counting' : 'In progressione') 
                   : horse.stats.sireRecord)
                : horse.stats.offspringEarnings}
            </div>
            <div class="hero-stat-label">Sire Record</div>
          </div>
        )}
        <div>
          <div class="hero-stat-value">{horse.yearOfBirth}</div>
          <div class="hero-stat-label">{t('horse.born')}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ACHIEVEMENTS -->
  {horse.achievements && horse.achievements.length > 0 && (
    <section class="achievements">
      <div class="achievements-inner">
        <div class="section-label">{t('horse.achievements')}</div>
        <div class="achievements-grid">
          {horse.achievements.sort((a, b) => parseInt(a.year) - parseInt(b.year)).map((item) => (
            <div class="achievement-item">
              <div class="achievement-year">{item.year}</div>
              <div class="achievement-text">{item.title}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- GALLERY & LOGO -->
  {(horse.gallery?.length > 0 || horse.logo) && (
    <section style="background: var(--cream); padding: 5rem 0 2rem;">
      <div class="container">
        <div class="section-label" style="margin-bottom: 2rem;">{t('horse.gallery')}</div>
        <div class="info-grid" style="align-items: center;">
          <div>
            {horse.gallery && horse.gallery.length > 0 && (
              <div class="gallery-strip" style="margin-top: 0; justify-content: flex-start;">
                {horse.gallery.map((img, index) => (
                  <img class="gallery-thumb" src={img} alt="" onclick={`window.openLightbox(${index})`}>
                ))}
              </div>
            )}
          </div>
          <div style="display: flex; justify-content: center; align-items: center; width: 100%;">
            {horse.logo && <img src={horse.logo} alt={`Logo ${horse.name}`} class="gallery-logo" style="margin-bottom: 0;" />}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- LIGHTBOX -->
  <div class="lightbox" id="lightbox" onclick="window.closeLightbox(event)">
    <button class="lightbox-close" onclick="window.closeLightbox()">×</button>
    <img id="lightbox-img" src="" alt="">
    <div class="lightbox-nav">
      <button onclick="window.changeLightbox(-1); event.stopPropagation()">← Prev</button>
      <button onclick="window.changeLightbox(1); event.stopPropagation()">Next →</button>
    </div>
  </div>

  <!-- VERSIONE DESKTOP (ORIGINALE) -->
