            )}
            <div class="social-buttons">
              {horse.social?.instagram && (<a href={horse.social.instagram} target="_blank" class="btn-social"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>Instagram</a>)}
              {horse.social?.facebook && (<a href={horse.social.facebook} target="_blank" class="btn-social"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>Facebook</a>)}
              {horse.social?.tiktok && (<a href={horse.social.tiktok} target="_blank" class="btn-social"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><g transform="scale(0.8) translate(3,3)"><path d="M12.53.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 2.22-1.15 4.31-2.92 5.56-1.74 1.25-4.04 1.65-6.07 1.07-2.11-.58-3.9-2.07-4.82-4.05-1.01-2.04-1-4.49.02-6.53 1.02-2.06 2.9-3.57 5.09-4.14.36-.1.73-.17 1.11-.21v4.06c-1.37.14-2.61.9-3.32 2.06-.7 1.15-.79 2.62-.23 3.84.55 1.22 1.71 2.06 3.01 2.22 1.34.17 2.69-.37 3.55-1.41.86-1.02 1.29-2.36 1.29-3.69-.02-5.74-.01-11.49-.01-17.23z"/></g></svg>TikTok</a>)}
              {horse.social?.website && (<a href={horse.social.website} target="_blank" class="btn-social"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>Sito ufficiale</a>)}
            </div>
          </div>
        </div>
        <!-- PEDIGREE -->
        <div class="pedigree-section">
          <h3>Pedigree</h3>
          <div class="ped-overflow">
            <div class="ped-grid">
              <div class="ped-horse">{horse.name}</div>
              <div class="ped-bracket"></div>
              <div class="ped-parents">
                <div class="ped-parent" set:html={renderHorseName(horse.pedigree?.sire)}></div>
                <div class="ped-parent" set:html={renderHorseName(horse.pedigree?.dam)}></div>
              </div>
              <div class="ped-ancestors">
                <div class="ped-grandunit"><div class="ped-small-bracket"></div><div class="ped-grandnames"><div class="ped-grand" set:html={renderHorseName(horse.pedigree?.grandsire_sire)}></div><div class="ped-grand" set:html={renderHorseName(horse.pedigree?.granddam_sire)}></div></div></div>
                <div class="ped-grandunit"><div class="ped-small-bracket"></div><div class="ped-grandnames"><div class="ped-grand" set:html={renderHorseName(horse.pedigree?.grandsire_dam)}></div><div class="ped-grand" set:html={renderHorseName(horse.pedigree?.granddam_dam)}></div></div></div>
              </div>
