          {horse.social?.facebook && (<a href={horse.social.facebook} target="_blank" class="btn-social"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>Facebook</a>)}
          {horse.social?.tiktok && (<a href={horse.social.tiktok} target="_blank" class="btn-social"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><g transform="scale(0.8) translate(3,3)"><path d="M12.53.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 2.22-1.15 4.31-2.92 5.56-1.74 1.25-4.04 1.65-6.07 1.07-2.11-.58-3.9-2.07-4.82-4.05-1.01-2.04-1-4.49.02-6.53 1.02-2.06 2.9-3.57 5.09-4.14.36-.1.73-.17 1.11-.21v4.06c-1.37.14-2.61.9-3.32 2.06-.7 1.15-.79 2.62-.23 3.84.55 1.22 1.71 2.06 3.01 2.22 1.34.17 2.69-.37 3.55-1.41.86-1.02 1.29-2.36 1.29-3.69-.02-5.74-.01-11.49-.01-17.23z"/></g></svg>TikTok</a>)}
          {horse.social?.website && (<a href={horse.social.website} target="_blank" class="btn-social"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>Sito ufficiale</a>)}
        </div>
      </div>
    </div>
  </section>

  <section class="pedigree-section mobile-only" style="padding: 2rem 0 5rem;">
    <div class="container">
      <div class="section-label">Pedigree</div>
      <div class="ped-overflow">
        <div class="ped-grid">
          <div class="ped-horse">{horse.name}</div>
          <div class="ped-bracket"></div>
          <div class="ped-parents">
            <div class="ped-parent" set:html={renderHorseName(horse.pedigree?.sire)}></div>
            <div class="ped-parent" set:html={renderHorseName(horse.pedigree?.dam)}></div>
          </div>
          <div class="ped-ancestors">
            <div class="ped-grandunit"><div class="ped-small-bracket"></div><div class="ped-grandnames"><div class="ped-grand" set:html={renderHorseName(horse.pedigree?.grandsire_sire)}></div><div class="ped-grand" set:html={renderHorseName(horse.pedigree?.granddam_sire)}></div></div></div>
            <div class="ped-grandunit"><div class="ped-small-bracket"></div><div class="ped-grandnames"><div class="ped-grand" set:html={renderHorseName(horse.pedigree?.grandsire_dam)}></div><div class="ped-grand" set:html={renderHorseName(horse.pedigree?.granddam_dam)}></div></div></div>
          </div>
        </div>
      </div>
      {horse.pedigreeUrl && <a href={horse.pedigreeUrl} target="_blank" class="ped-fulllink">{isEn ? 'Full Pedigree' : 'Pedigree completo'} →</a>}
      
      {combinedSiblings.length > 0 && (
        <div class="siblings-disclaimer" style="margin-top: 1.5rem; border-top: 1px solid rgba(0,0,0,0.05); padding-top: 1rem;">
          <span class="siblings-label">{isEn ? 'Full Siblings:' : 'Fratelli Pieni:'}</span>
          {combinedSiblings.map((sib, index) => (
            <>
              {sib.slug ? (
                <a href={`/${lang}/${sib.collection === 'stalloni' ? 'stalloni' : 'fattrici'}/${sib.slug}`} class="sibling-link">
                  {sib.name}
                </a>
              ) : (
                <span class="sibling-text">{sib.name}</span>
              )}
              {index < combinedSiblings.length - 1 && <span style="margin: 0 4px; color: rgba(200,151,58,0.5);">·</span>}
            </>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- DESCRIPTION SECTION -->
  {(horse.description_it || horse.description_en) && (
    <section class="description-section" id="description" style="padding: 5rem 0; background: white;">
      <div class="container">
        <div class="section-label">{t('horse.desc_title')}</div>
        <div class="description-content" style="max-width: 800px; line-height: 1.8; color: var(--dark); font-size: 1.1rem;">
          {isEn ? (horse.description_en || horse.description_it) : (horse.description_it || horse.description_en)}
        </div>
      </div>
    </section>
  )}

  <!-- VIDEO -->
  {embedUrl && (
    <section class="video-section">
      <div class="container">
        <div class="video-header"><div class="section-label" style="color:rgba(200,151,58,0.6); margin:0;">Video</div><div class="video-title" style="color:white;">{t('horse.in_arena')}</div></div>
        <div class="video-wrapper">
          <iframe 
            src={horse.videoUrl.includes('vimeo.com') 
              ? horse.videoUrl.replace('vimeo.com/', 'player.vimeo.com/video/') 
              : horse.videoUrl.includes('facebook.com')
                ? `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(horse.videoUrl)}&show_text=0&width=560`
                : horse.videoUrl.replace('youtu.be/', 'www.youtube.com/embed/').replace('watch?v=', 'embed/')}
            title="Video"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>
  )}

  <!-- OFFSPRING -->
  {combinedOffspring.length > 0 && (
    <section class="offspring-section">
      <div class="container">
        <div class="offspring-header">
          <div class="offspring-title">{t('horse.offspring')}</div>
          {(horse.stats?.sireRecord || horse.stats?.offspringEarnings) && (
            <div class="offspring-count">
              Sire record: {isEn 
                ? (horse.stats.sireRecord_en || horse.stats.sireRecord || horse.stats.offspringEarnings_en || horse.stats.offspringEarnings) 
                : (horse.stats.sireRecord || horse.stats.offspringEarnings)}
            </div>
          )}
        </div>
        <div class="offspring-list">
          {combinedOffspring.map(off => (
            <div class="offspring-item">
              <span class="offspring-name">
                {off.slug ? (
                  <a href={`${langPrefix}/${off.collection === 'stalloni' ? 'stalloni' : 'fattrici'}/${off.slug}`}>
                    {off.name}
                  </a>
                ) : (
                  <span>{off.name}</span>
                )}
                {off.achievements && (
                  <div style="font-size: 0.7rem; color: var(--warm-gray); margin-top: 2px; font-weight: 300;">{off.achievements}</div>
                )}
              </span>
              <span class="offspring-earnings">{off.earnings}</span>
            </div>
          ))}
        </div>
        <a href={horse.offspringUrl || horse.pedigreeUrl || "#"} target="_blank" class="offspring-link">{isEn ? 'All offspring' : 'Tutti gli offspring'} →</a>
      </div>
    </section>
  )}

  <!-- BREEDING -->
  <section class="breeding-section">
    <div class="container">
      <div class="section-label">Breeding Info</div>
      <div class="breeding-grid">
        <div class="breeding-card"><div class="breeding-card-label">{t('horse.fee')}</div><div class="breeding-card-value">{isEn ? (horse.breeding?.fee_en || horse.breeding?.fee) : horse.breeding?.fee}</div><div class="breeding-card-sub">{isEn ? 'Per breeding' : 'Per monta'}</div></div>
        <div class="breeding-card"><div class="breeding-card-label">{t('horse.semen')}</div><div class="breeding-card-value">{isEn ? (horse.breeding?.semenType_en || horse.breeding?.semenType) : horse.breeding?.semenType}</div><div class="breeding-card-sub">{isEn ? (horse.breeding?.semenNotes_en || horse.breeding?.semenNotes) : horse.breeding?.semenNotes}</div></div>
        <div class="breeding-card"><div class="breeding-card-label">{t('horse.status')}</div><div class="breeding-card-value">{(isEn && horse.breeding?.status_en) ? horse.breeding.status_en : horse.breeding?.status}</div><div class="breeding-card-sub">{isEn ? (horse.breeding?.statusNotes_en || horse.breeding?.statusNotes) : horse.breeding?.statusNotes}</div></div>
      </div>
      <p style="font-size: 0.75rem; color: var(--warm-gray); margin-top: 1rem; text-align: left; font-style: italic;">
        {isEn ? '* The breeding fee is indicative and may vary based on the period, availability, or chosen facility. Please refer to the official links below for precise costs and contracts.' : '* Il prezzo della monta è indicativo e può subire variazioni in base al periodo, alla disponibilità o alla struttura scelta. Consulta i link ufficiali qui sotto per i costi e i contratti aggiornati.'}
      </p>
      <div class="breeding-links">
        {horse.breedingLinks?.map(l => (
          <a href={l.url} target="_blank" class={l.primary ? "btn-primary" : "btn-outline"}>{l.label} →</a>
        ))}
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ galleryImages: horse.gallery || [] }}>
    let currentIndex = 0;
    window.openLightbox = (index) => {
      currentIndex = index;
      document.getElementById('lightbox-img').src = galleryImages[index];
      document.getElementById('lightbox').classList.add('active');
      document.body.style.overflow = 'hidden';
    };
    window.closeLightbox = (e) => {
      if (!e || e.target.id === 'lightbox' || e.target.classList.contains('lightbox-close')) {
        document.getElementById('lightbox').classList.remove('active');
        document.body.style.overflow = '';
      }
    };
    window.changeLightbox = (dir) => {
      currentIndex = (currentIndex + dir + galleryImages.length) % galleryImages.length;
      document.getElementById('lightbox-img').src = galleryImages[currentIndex];
    };
  </script>
  </div>
</Layout>
