---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const stalloniEntries = await getCollection('stalloni');
  const locales = ['it', 'en'];

  return locales.flatMap((lang) => {
    return stalloniEntries
      .filter(entry => !entry.id.startsWith('_'))
      .map(entry => ({
        params: { lang, slug: entry.id },
        props: { entry, lang },
      }));
  });
}

const { entry, lang } = Astro.props;
const horse = entry.data;

import { useTranslations } from '../../../i18n/utils';
const t = useTranslations(lang);
const isEn = lang === 'en';
const langPrefix = '/' + lang;

// Mappatura nomi-slug per pedigree (Stalloni + Fattrici)
const allStalloni = await getCollection('stalloni');
const allFattrici = await getCollection('fattrici');
const allHorses = [...allStalloni, ...allFattrici];

const horseMap = new Map(allHorses.map(h => [h.data.name?.toUpperCase().trim(), { id: h.id, collection: h.collection }]));

function toTitleCase(str) {
  if (!str) return "";
  return str.toLowerCase().split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
}

function renderHorseName(name) {
  if (!name) return "-";
  const cleanName = name.toUpperCase().trim();
  const found = horseMap.get(cleanName);
  if (found) return `<a href="${langPrefix}/${found.collection === 'stalloni' ? 'stalloni' : 'fattrici'}/${found.id}">${name}</a>`;
  return name;
}

// LOGICA AUTOMAZIONE OFFSPRING
const currentHorseName = horse.name?.toUpperCase().trim();
const foundOffspring = allHorses
  .filter(h => h.data.pedigree?.sire?.toUpperCase().trim() === currentHorseName)
  .map(h => ({
    name: toTitleCase(h.data.name),
    earnings: h.data.stats?.earnings || "N/A",
    slug: h.id,
    collection: h.collection
  }));

// Unione con lista manuale (evitando duplicati)
const manualOffspring = (horse.offspring || []).map(off => ({
  ...off,
  name: toTitleCase(off.name),
  manual: true
}));

const combinedOffspring = [...foundOffspring];
manualOffspring.forEach(mon => {
    const isDuplicate = combinedOffspring.some(a => a.name?.toUpperCase().trim() === mon.name?.toUpperCase().trim());
    if (!isDuplicate) {
        combinedOffspring.push(mon);
    }
});

// Funzione di formattazione guadagni per figli
function formatOffspringEarnings(earnStr) {
  if (!earnStr) return "N/D";
  if (earnStr.toLowerCase() === 'counting' || earnStr.toLowerCase().includes('progressione')) return "Counting";
  let clean = earnStr.trim();
  if (clean && !clean.endsWith('+') && clean.includes('$')) clean += '+';
  return clean;
}

// Funzione estrazione numero per sorting
function getEarningsValue(earnStr) {
  if (!earnStr || earnStr.toLowerCase() === 'counting' || earnStr.toLowerCase() === 'n/a' || earnStr.toLowerCase() === 'n/d') return 0;
  return parseInt(earnStr.replace(/[^0-9]/g, ''), 10) || 0;
}

// Applica formattazione a tutti i figli
combinedOffspring.forEach(off => {
  off.earnings = formatOffspringEarnings(off.earnings);
});

// Sorting decrescente per vincite (e poi alfabetico per parità)
combinedOffspring.sort((a, b) => {
  const valA = getEarningsValue(a.earnings);
  const valB = getEarningsValue(b.earnings);
  if (valA !== valB) return valB - valA;
  return (a.name || "").localeCompare(b.name || "");
});

// Split nome hero
const originalParts = (horse.name || "").toUpperCase().trim().split(' ');
const needsBr = originalParts.length >= 3;
const lastWord  = originalParts.length > 1 ? originalParts.pop() : "";
const firstPart = originalParts.join(' ');


// Video embed (YouTube & Facebook)
function getVideoEmbed(url) {
  if (!url) return null;
  
  // YouTube (Standard o No-Cookie)
  const ytMatch = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|embed\/|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
  if (ytMatch) return `https://www.youtube-nocookie.com/embed/${ytMatch[1]}`;
  
  // Facebook
  if (url.includes('facebook.com')) {
    return `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(url)}&show_text=0&width=560`;
  }
  
  return url;
}
const embedUrl = getVideoEmbed(horse.videoUrl);

// LOGICA AUTOMAZIONE SIBLINGS (Fratelli Pieni)
const currentSire = horse.pedigree?.sire?.toUpperCase().trim();
const currentDam = horse.pedigree?.dam?.toUpperCase().trim();

const foundSiblings = (currentSire && currentDam) 
  ? allHorses
      .filter(h => 
        h.id !== entry.id && 
        h.data.pedigree?.sire?.toUpperCase().trim() === currentSire &&
        h.data.pedigree?.dam?.toUpperCase().trim() === currentDam
      )
      .map(h => ({
        name: toTitleCase(h.data.name),
        slug: h.id,
        collection: h.collection
      }))
  : [];

const manualSiblings = (horse.siblings || []).map(sib => ({
  name: typeof sib === 'string' ? toTitleCase(sib) : toTitleCase(sib.name),
  manual: true
}));

const combinedSiblings = [...foundSiblings];
manualSiblings.forEach(ms => {
  if (!combinedSiblings.some(s => s.name.toUpperCase().trim() === ms.name.toUpperCase().trim())) {
    combinedSiblings.push(ms);
  }
});

// Calcolo numero Panel Genetici
const geneticEntries = horse.geneticTest ? Object.entries(horse.geneticTest).filter(([_, val]) => val && val !== "") : [];
const panelCount = geneticEntries.length;
