          {horse.pedigreeUrl && <a href={horse.pedigreeUrl} target="_blank" class="ped-fulllink">{isEn ? 'Full Pedigree' : 'Pedigree completo'} →</a>}
          
          {combinedSiblings.length > 0 && (
            <div class="siblings-disclaimer">
              <span class="siblings-label">{isEn ? 'Full Siblings:' : 'Fratelli Pieni:'}</span>
              {combinedSiblings.map((sib, index) => (
                <>
                  {sib.slug ? (
                    <a href={`/${lang}/${sib.collection === 'stalloni' ? 'stalloni' : 'fattrici'}/${sib.slug}`} class="sibling-link">
                      {sib.name}
                    </a>
                  ) : (
                    <span class="sibling-text">{sib.name}</span>
                  )}
                  {index < combinedSiblings.length - 1 && <span style="margin: 0 4px; color: rgba(200,151,58,0.5);">·</span>}
                </>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

