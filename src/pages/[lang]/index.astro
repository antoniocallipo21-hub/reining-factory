</style>

<script define:vars={{ isEn, eventiData }}>
  const MESI_IT = ['Gen','Feb','Mar','Apr','Mag','Giu','Lug','Ago','Set','Ott','Nov','Dic'];
  const MESI_EN = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const months = isEn ? MESI_EN : MESI_IT;

  function parseDate(str) {
    if (!str) return null;
    const parts = str.trim().split('/');
    if (parts.length !== 3) return null;
    return new Date(parseInt(parts[2]), parseInt(parts[1]) - 1, parseInt(parts[0]));
  }

  function badgeClass(ev) {
    let t = (ev.tipo || '').toLowerCase().trim();
    const luogo = (ev.luogo || '').toUpperCase();
    
    // Se il tipo è vuoto, proviamo a dedurlo dalla location
    if (!t) {
      if (luogo.includes('USA') || luogo.includes('UNITED STATES')) {
        t = 'usa';
      } else {
        t = 'europeo'; // Default se non è USA e manca il tipo
      }
    }
    
    if (t === 'nazionale') return 'badge-nazionale';
    if (t === 'europeo') return 'badge-europeo';
    if (t === 'major') return 'badge-major';
    if (t === 'usa') return 'badge-usa';
    return 'badge-altro';
  }

  function loadEventi() {
    const container = document.getElementById('eventiList');
    if (!container) return;
    try {
      const today = new Date();
      today.setHours(0,0,0,0);

      const futuri = eventiData
        .filter(ev => { const fine = parseDate(ev.dataFine); return fine && fine >= today; })
        .sort((a, b) => parseDate(a.dataInizio) - parseDate(b.dataInizio))
        .slice(0, 5);

      if (futuri.length === 0) {
        container.innerHTML = `<div class="evento-row"><div><div class="ev-name">${isEn ? 'No upcoming events' : 'Nessun evento in programma'}</div></div></div>`;
        return;
      }

      container.innerHTML = futuri.map(ev => {
        const inizio = parseDate(ev.dataInizio);
        const giorno = inizio ? inizio.getDate().toString().padStart(2,'0') : '—';
        const mese = inizio ? months[inizio.getMonth()] + ' ' + inizio.getFullYear() : '';
        const tipo = ev.tipo || '';
        return `
          <div class="evento-row">
            <div>
              <div class="ev-date">${giorno}</div>
              <div class="ev-month">${mese}</div>
            </div>
            <div>
              <div class="ev-name">${ev.titolo || ''}</div>
              <div class="ev-location"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:4px;margin-bottom:2px;"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>${ev.luogo || ''}</div>
            </div>
            <span class="ev-badge ${badgeClass(ev)}">${ev.tipo || (badgeClass(ev) === 'badge-usa' ? 'USA' : 'Europeo')}</span>
          </div>`;
      }).join('');
    } catch(e) {
      const container = document.getElementById('eventiList');
      if (container) container.innerHTML = `<div class="evento-row"><div><div class="ev-name" style="color:rgba(245,240,232,0.4)">${isEn ? 'Could not load events' : 'Impossibile caricare gli eventi'}</div></div></div>`;
    }
  }

  // Tutto dentro astro:page-load per compatibilità con View Transitions
  document.addEventListener('astro:page-load', () => {
    // Contatori animati — reset a 0 e riavvia ad ogni navigazione
    const cObs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          const el = e.target, target = parseInt(el.dataset.count);
          let current = 0;
          const step = target / (1800 / 16);
          const tInterval = setInterval(() => {
            current += step;
            if (current >= target) { current = target; clearInterval(tInterval); }
            el.textContent = Math.floor(current) + '+';
          }, 16);
          cObs.unobserve(el);
        }
      });
    }, { threshold: 0.5 });
    // Reset visivo prima di osservare (in caso di navigazione back/forward)
    document.querySelectorAll('[data-count]').forEach(c => {
      c.textContent = '0';
      cObs.observe(c);
    });

    // Carica eventi dal Google Sheet
    loadEventi();
  });
</script>
