---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';

import eventiData from '../../data/calendario.json';

export async function getStaticPaths() {
  return [
    { params: { lang: 'it' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang);
const isEn = lang === 'en';
const langPrefix = '/' + lang;

const featuredStallions = (await getCollection('stalloni', ({ data }) => {
  return data.isFeatured === true;
})).slice(0, 4);
---

<Layout
  title={isEn ? "Reining Factory — The complete Reining resource" : "Reining Factory — La Risorsa completa sul Reining"}
  description={isEn ? "Bloodlines, stallions, mares, events and history of reining." : "Linee di sangue, stalloni, fattrici, eventi e storia del reining. La risorsa italiana più completa su questo sport."}
>
  <link slot="head" rel="preload" as="image" href="/immagini/hero.jpg" />

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">{t('home.hero_eyebrow')}</p>
      <h1 class="hero-title">
        <span set:html={t('home.hero_title')} />
        <em set:html={t('home.hero_title_em')} />
      </h1>
      <p class="hero-subtitle">{t('home.hero_sub')}</p>
      <div class="hero-cta">
        <a href={langPrefix + "/stalloni"} class="btn-primary">{t('home.hero_cta_stalloni')}</a>
        <a href={langPrefix + "/reining"} class="btn-ghost">{t('home.hero_cta_sport')}</a>
      </div>
    </div>
    <div class="scroll-indicator">
      <span class="scroll-text">{t('home.scroll')}</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- STATS -->
  <div class="stats-bar">
    <div class="stat-item"><div class="stat-number" data-count="100">0</div><div class="stat-label">{t('home.stats.stalloni')}</div></div>
    <div class="stat-divider"></div>
    <div class="stat-item"><div class="stat-number" data-count="10">0</div><div class="stat-label">{t('home.stats.fattrici')}</div></div>
    <div class="stat-divider"></div>
    <div class="stat-item"><div class="stat-number" data-count="10">0</div><div class="stat-label">{t('home.stats.linee')}</div></div>
    <div class="stat-divider"></div>
    <div class="stat-item"><div class="stat-number" data-count="58">0</div><div class="stat-label">{t('home.stats.storia')}</div></div>
  </div>

  <!-- INTRO -->
  <section class="intro-section">
    <div class="intro-text reveal-left">
      <p class="section-label">{t('home.intro.label')}</p>
      <h2 class="section-title">{t('home.intro.title')}<br><em>{t('home.intro.title_em')}</em></h2>
      <p>{t('home.intro.p1')}</p>
      <p>{t('home.intro.p2')}</p>
      <a href={langPrefix + "/reining"} class="btn-ghost" style="color:var(--gold);margin-top:1rem;">{t('home.intro.cta')}</a>
    </div>
    <div class="intro-img-wrap reveal-right">
      <img src="/immagini/reining-intro.jpg" alt="Sliding stop nel reining" loading="lazy" width="800" height="440"/>
      <span class="img-caption">{t('home.intro.caption')}</span>
    </div>
  </section>

  <!-- SEZIONI -->
  <div class="sections-wrap">
    <p class="section-label reveal">{t('home.sections.label')}</p>
    <h2 class="section-title reveal">{t('home.sections.title')}<br><em>{t('home.sections.title_em')}</em></h2>
    <div class="cards-grid">
      <a href={langPrefix + "/stalloni"} class="sec-card reveal d1">
        <div class="card-num">01</div>
        <div class="card-icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5"/><path d="m21 3-6.75 6.75"/><circle cx="10" cy="14" r="6"/></svg></div>
        <h3 class="card-title">{t('nav.stalloni')}</h3>
        <p class="card-desc">{t('home.sections.stalloni_desc')}</p>
        <span class="card-arrow">→</span>
      </a>
      <a href={langPrefix + "/fattrici"} class="sec-card reveal d2">
        <div class="card-num">02</div>
        <div class="card-icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15v7"/><path d="M9 19h6"/><circle cx="12" cy="9" r="6"/></svg></div>
        <h3 class="card-title">{t('nav.fattrici')}</h3>
        <p class="card-desc">{t('home.sections.fattrici_desc')}</p>
        <span class="card-arrow">→</span>
      </a>
      <a href={langPrefix + "/hall-of-fame"} class="sec-card reveal d3">
        <div class="card-num">03</div>
        <div class="card-icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"/><circle cx="12" cy="8" r="6"/></svg></div>
        <h3 class="card-title">Hall of Fame</h3>
        <p class="card-desc">{t('home.sections.hof_desc')}</p>
        <span class="card-arrow">→</span>
      </a>
      <a href={langPrefix + "/million-dollar-earners"} class="sec-card reveal d1">
        <div class="card-num">04</div>
        <div class="card-icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="2" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div>
        <h3 class="card-title">Million Dollar Earners</h3>
        <p class="card-desc">{t('home.sections.million_desc')}</p>
        <span class="card-arrow">→</span>
      </a>
      <a href={langPrefix + "/storico"} class="sec-card reveal d2">
        <div class="card-num">05</div>
        <div class="card-icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17V5a2 2 0 0 0-2-2H4"/><path d="M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3"/></svg></div>
        <h3 class="card-title">{t('nav.storico')}</h3>
        <p class="card-desc">{t('home.sections.storico_desc')}</p>
        <span class="card-arrow">→</span>
      </a>
      <a href={langPrefix + "/calendario"} class="sec-card reveal d3">
        <div class="card-num">06</div>
        <div class="card-icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg></div>
        <h3 class="card-title">{t('nav.calendario')}</h3>
        <p class="card-desc">{t('home.sections.calendario_desc')}</p>
        <span class="card-arrow">→</span>
      </a>
    </div>
  </div>

  <!-- STALLONI PREVIEW -->
  <section class="stalloni-section">
    <div class="stalloni-header">
      <div>
        <p class="section-label reveal">{t('home.featured.label')}</p>
        <h2 class="section-title reveal">{t('home.featured.title')} <em>{t('home.featured.title_em')}</em></h2>
      </div>
      <a href={langPrefix + "/stalloni"} class="btn-ghost reveal" style="color:var(--gold);">{t('home.featured.all')}</a>
    </div>
    <div class="stalloni-grid">
      {featuredStallions.length > 0 ? featuredStallions.map((s, i) => (
        <a href={langPrefix + "/stalloni/" + s.id} class={`stallone-card reveal d${(i % 4) + 1}`}>
          <div class="s-name">{s.data.name}</div>
          <div class="s-line">{s.data.pedigree?.sire || ''}</div>
          <div class="s-info">
            {s.data.yearOfBirth ? `${isEn ? 'Born' : 'Nato'} ${s.data.yearOfBirth}` : ''}
            {s.data.stats?.earnings ? ` · LTE: ${s.data.stats.earnings}` : ''}
          </div>
          {(s.data.badge || s.data.badge_en) && <span class="s-tag">{isEn ? (s.data.badge_en || s.data.badge) : (s.data.badge || s.data.badge_en)}</span>}
        </a>
      )) : (
        <div class="stallone-card" style="grid-column:1/-1;text-align:center;color:rgba(245,240,232,0.3);padding:3rem;">
          {t('home.featured.empty')}
        </div>
      )}
    </div>
  </section>

  <!-- CALENDARIO DINAMICO -->
  <section class="calendario-section">
    <p class="section-label reveal">{t('home.events.label')}</p>
    <h2 class="section-title reveal">{t('home.events.title')} <em>{t('home.events.title_em')}</em></h2>
    <div class="eventi-list reveal" id="eventiList">
      <div class="ev-skeleton"><div class="ev-skeleton-line" style="width:30%"></div><div class="ev-skeleton-line" style="width:70%"></div></div>
      <div class="ev-skeleton"><div class="ev-skeleton-line" style="width:30%"></div><div class="ev-skeleton-line" style="width:60%"></div></div>
      <div class="ev-skeleton"><div class="ev-skeleton-line" style="width:30%"></div><div class="ev-skeleton-line" style="width:75%"></div></div>
    </div>
    <div style="margin-top:1.5rem;">
      <a href={langPrefix + "/calendario"} class="btn-ghost reveal" style="color:var(--gold);">{t('home.events.all')}</a>
    </div>
  </section>

  <!-- CHI SIAMO -->
  <section class="chisiamo-section">
    <p class="section-label reveal">{t('home.about.label')}</p>
    <h2 class="section-title reveal">{t('home.about.title')}<br><em>{t('home.about.title_em')}</em></h2>
    <div class="chisiamo-grid">
      <div class="cs-card reveal d1">
        <div class="cs-icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
        <h3 class="cs-title">{t('home.about.cs_title')}</h3>
        <p class="cs-text">{t('home.about.cs_text')}</p>
      </div>
      <div class="cs-card reveal d2">
        <div class="cs-icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09"/><path d="M9 12a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.4 22.4 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 .05 5 .05"/></svg></div>
        <h3 class="cs-title">{t('home.about.ms_title')}</h3>
        <p class="cs-text">{t('home.about.ms_text')}</p>
      </div>
      <div class="cs-card reveal d3">
        <div class="cs-icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19.414 14.414C21 12.828 22 11.5 22 9.5a5.5 5.5 0 0 0-9.591-3.676.6.6 0 0 1-.818.001A5.5 5.5 0 0 0 2 9.5c0 2.3 1.5 4 3 5.5l5.535 5.362a2 2 0 0 0 2.879.052 2.12 2.12 0 0 0-.004-3 2.124 2.124 0 1 0 3-3 2.124 2.124 0 0 0 3.004 0 2 2 0 0 0 0-2.828l-1.881-1.882a2.41 2.41 0 0 0-3.409 0l-1.71 1.71a2 2 0 0 1-2.828 0 2 2 0 0 1 0-2.828l2.823-2.762"/></svg></div>
        <h3 class="cs-title">{t('home.about.pj_title')}</h3>
        <p class="cs-text">{t('home.about.pj_text')}</p>
        <a href={langPrefix + "/contatti"} class="cs-link">{t('home.about.pj_link')} →</a>
      </div>
    </div>
  </section>

  <!-- QUOTE -->
  <div class="quote-section">
    <p class="quote-text">{t('home.quote')}</p>
    <p class="quote-attr">— ITALIAN REINING HORSE ASSOCIATION</p>
  </div>

</Layout>

<style is:global>
  /* HERO */
  .hero { min-height:100vh; position:relative; display:flex; align-items:flex-start; overflow:hidden; }
  .hero-bg {
    position:absolute; inset:0;
    background: linear-gradient(135deg, rgba(26,20,8,0.88) 40%, rgba(107,76,42,0.35) 100%),
      url('/immagini/hero.jpg') center/cover no-repeat;
  }
  .hero-bg::after { content:''; position:absolute; inset:0; background:radial-gradient(ellipse at 70% 50%, rgba(201,150,58,0.07) 0%, transparent 70%); }
  .hero-content { position:relative; z-index:2; padding:150px 4rem 0 4rem; max-width:900px; }
  .hero-eyebrow { font-family:'Barlow Condensed',sans-serif; font-size:0.8rem; letter-spacing:0.3em; text-transform:uppercase; color:var(--gold); margin-bottom:1.5rem; opacity:0; transform:translateY(20px); animation:fadeUp 0.8s ease 0.3s forwards; }
  .hero-title { font-family:'Playfair Display',serif; font-size:clamp(3.5rem,8vw,7rem); line-height:0.95; font-weight:900; margin-bottom:1.2rem; opacity:0; transform:translateY(30px); animation:fadeUp 0.9s ease 0.5s forwards; }
  .hero-title em { font-style:italic; color:var(--gold); display:block; }
  .hero-subtitle { font-size:1.1rem; font-weight:300; color:rgba(245,240,232,0.7); max-width:500px; line-height:1.75; margin-bottom:1.5rem; opacity:0; transform:translateY(20px); animation:fadeUp 0.9s ease 0.8s forwards; }
  .hero-cta { display:flex; gap:1.5rem; align-items:center; opacity:0; transform:translateY(20px); animation:fadeUp 0.9s ease 1s forwards; }
  .scroll-indicator { position:absolute; bottom:3rem; left:50%; transform:translateX(-50%); z-index:2; opacity:0; animation:fadeUp 1s ease 1.5s forwards; display:flex; flex-direction:column; align-items:center; gap:0.5rem; }
  .scroll-line { width:1px; height:60px; background:linear-gradient(to bottom,var(--gold),transparent); animation:scrollPulse 2s ease infinite; }
  .scroll-text { font-family:'Barlow Condensed',sans-serif; font-size:0.7rem; letter-spacing:0.2em; color:rgba(201,150,58,0.6); text-transform:uppercase; }

  /* STATS */
  .stats-bar { background:var(--gold); padding:1.4rem 4rem; display:flex; justify-content:space-around; align-items:center; }
  .stat-item { text-align:center; color:var(--dark); }
  .stat-number { font-family:'Playfair Display',serif; font-size:2.2rem; font-weight:900; line-height:1; }
  .stat-label { font-family:'Barlow Condensed',sans-serif; font-size:0.72rem; letter-spacing:0.15em; text-transform:uppercase; opacity:0.65; margin-top:0.2rem; }
  .stat-divider { width:1px; height:40px; background:rgba(26,20,8,0.2); }

  /* INTRO */
  .intro-section { padding:7rem 4rem; display:grid; grid-template-columns:1fr 1fr; gap:6rem; align-items:center; background:var(--dark); }
  .intro-text p { color:rgba(245,240,232,0.65); line-height:1.9; margin-bottom:1.5rem; font-size:1.02rem; }
  .intro-img-wrap { position:relative; }
  .intro-img-wrap img { width:100%; height:440px; object-fit:cover; display:block; filter:sepia(15%) contrast(1.05); }
  .intro-img-wrap::before { content:''; position:absolute; top:-18px; left:-18px; right:18px; bottom:18px; border:1px solid rgba(201,150,58,0.25); pointer-events:none; z-index:1; }
  .intro-img-wrap::after { content:''; position:absolute; inset:0; background:linear-gradient(to top,rgba(26,20,8,0.45) 0%,transparent 50%); }
  .img-caption { position:absolute; bottom:1.2rem; left:1.2rem; z-index:3; font-family:'Barlow Condensed',sans-serif; font-size:0.75rem; letter-spacing:0.1em; color:rgba(245,240,232,0.75); }

  /* CARDS */
  .sections-wrap { background:var(--bg2); padding:7rem 4rem; }
  .cards-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--border); margin-top:3.5rem; }
  .sec-card { background:var(--dark); padding:2.5rem 2rem; position:relative; overflow:hidden; transition:background 0.35s ease,transform 0.35s ease; text-decoration:none; color:inherit; display:block; }
  .sec-card:hover { background:var(--card); transform:translateY(-3px); }
  .sec-card::before { content:''; position:absolute; bottom:0; left:0; height:2px; width:0; background:var(--gold); transition:width 0.4s ease; }
  .sec-card:hover::before { width:100%; }
  .card-num { font-family:'Playfair Display',serif; font-size:3.5rem; font-weight:900; color:rgba(201,150,58,0.08); line-height:1; margin-bottom:0.75rem; transition:color 0.4s; }
  .sec-card:hover .card-num { color:rgba(201,150,58,0.2); }
  .card-icon { font-size:1.6rem; margin-bottom:0.75rem; color:var(--gold); opacity:0.9; }
  .card-title { font-family:'Playfair Display',serif; font-size:1.3rem; font-weight:700; margin-bottom:0.6rem; color:var(--cream); }
  .card-desc { font-size:0.9rem; color:rgba(245,240,232,0.5); line-height:1.7; }
  .card-arrow { position:absolute; bottom:1.8rem; right:1.8rem; color:var(--gold); opacity:0; transform:translateX(-6px); transition:all 0.3s ease; }
  .sec-card:hover .card-arrow { opacity:1; transform:translateX(0); }

  /* STALLONI PREVIEW */
  .stalloni-section { padding:7rem 4rem; background:var(--dark); }
  .stalloni-header { display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:2.5rem; }
  .stalloni-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:1px; background:var(--border); }
  .stallone-card { background:var(--dark); padding:1.8rem; position:relative; overflow:hidden; transition:background 0.3s; text-decoration:none; color:inherit; display:block; }
  .stallone-card:hover { background:var(--card); }
  .stallone-card::after { content:''; position:absolute; top:0; left:0; width:2px; height:0; background:var(--gold); transition:height 0.35s ease; }
  .stallone-card:hover::after { height:100%; }
  .s-name { font-family:'Playfair Display',serif; font-size:1rem; font-weight:700; margin-bottom:0.3rem; }
  .s-line { font-family:'Barlow Condensed',sans-serif; font-size:0.72rem; letter-spacing:0.1em; color:var(--gold); text-transform:uppercase; margin-bottom:0.6rem; }
  .s-info { font-size:0.82rem; color:rgba(245,240,232,0.45); line-height:1.6; }
  .s-tag { display:inline-block; margin-top:0.7rem; padding:0.18rem 0.55rem; background:rgba(201,150,58,0.08); border:1px solid rgba(201,150,58,0.2); font-family:'Barlow Condensed',sans-serif; font-size:0.65rem; letter-spacing:0.1em; text-transform:uppercase; color:var(--gold); }

  /* CALENDARIO */
  .calendario-section { background:var(--bg2); padding:7rem 4rem; }
  .eventi-list { margin-top:2.5rem; border:1px solid var(--border); }
  .evento-row { display:grid; grid-template-columns:90px 1fr auto; align-items:center; padding:1.4rem 2rem; border-bottom:1px solid rgba(201,150,58,0.08); transition:background 0.3s; gap:2rem; }
  .evento-row:last-child { border-bottom:none; }
  .evento-row:hover { background:rgba(201,150,58,0.03); }
  .ev-date { font-family:'Playfair Display',serif; font-size:1.7rem; font-weight:900; color:var(--gold); line-height:1; }
  .ev-month { font-family:'Barlow Condensed',sans-serif; font-size:0.72rem; letter-spacing:0.15em; text-transform:uppercase; color:rgba(201,150,58,0.55); }
  .ev-name { font-family:'Playfair Display',serif; font-size:1.05rem; font-weight:700; margin-bottom:0.2rem; }
  .ev-location { font-size:0.82rem; color:rgba(245,240,232,0.45); font-family:'Barlow Condensed',sans-serif; }
  .ev-badge { padding:0.35rem 0.9rem; font-family:'Barlow Condensed',sans-serif; font-size:0.7rem; letter-spacing:0.1em; text-transform:uppercase; border:1px solid; white-space:nowrap; }
  .badge-nazionale { color:#7ab8a0; border: 1px solid rgba(122,184,160,0.3); background: rgba(122,184,160,0.15); }
  .badge-europeo { color: #8bb9fe; border: 1px solid rgba(13,110,253,0.3); background: rgba(13,110,253,0.15); }
  .badge-usa { color: #ed7b86; border: 1px solid rgba(220,53,69,0.3); background: rgba(220,53,69,0.15); }
  .badge-altro { color:rgba(245,240,232,0.4); border: 1px solid rgba(245,240,232,0.2); background: rgba(245,240,232,0.05); }
  .ev-skeleton { padding:1.4rem 2rem; border-bottom:1px solid rgba(201,150,58,0.08); }
  .ev-skeleton-line { height:14px; background:rgba(201,150,58,0.08); border-radius:2px; margin-bottom:8px; animation:shimmer 1.5s infinite; }
  @keyframes shimmer { 0%,100%{opacity:0.4} 50%{opacity:0.8} }

  /* CHI SIAMO */
  .chisiamo-section { background:var(--dark); padding:7rem 4rem; border-top:1px solid var(--border); }
  .chisiamo-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--border); margin-top:3rem; }
