  .quote-attr { font-family:'Barlow Condensed',sans-serif; font-size:0.8rem; letter-spacing:0.2em; text-transform:uppercase; color:rgba(26,20,8,0.55); }

  /* RESPONSIVE */
  @media (max-width:1024px) {
    .hero-content { padding:150px 2rem 0 2rem; }
    .intro-section { padding:5rem 2rem; gap:3rem; }
    .sections-wrap { padding:5rem 2rem; }
