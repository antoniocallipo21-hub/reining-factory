---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

export async function getStaticPaths() {
  return [
    { params: { lang: 'it' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang);
const isEn = lang === 'en';
const langPrefix = '/' + lang;

// Recupera tutti gli stalloni ignorando i file template (che iniziano con _)
const allStalloniRaw = await getCollection('stalloni');
const allStalloni = allStalloniRaw.filter(s => !s.id.startsWith('_'));

// Ordina per nome
allStalloni.sort((a, b) => a.data.name.localeCompare(b.data.name));

// Estrai valori univoci per i filtri
const uniqueColors = [...new Set(
  allStalloni.map(s => isEn ? (s.data.color_en || s.data.color) : s.data.color).filter(Boolean)
)].sort();

const uniqueSemen = [...new Set(
  allStalloni.map(s => {
    const raw = isEn ? (s.data.breeding?.semenType_en || s.data.breeding?.semenType) : s.data.breeding?.semenType;
    if (!raw) return [];
    // Splitta per "/" o "," e pulisce gli spazi
    return raw.split(/[\/\,]+/).map(item => item.trim().toLowerCase());
  }).flat().filter(Boolean)
)].sort();

// Helper: determina badge presenti
// Helper: determina badge presenti (MOSTRA SIA Million Dollar CHE Hall of Fame)
function getBadges(tags, bCard, bHero) {
  const combined = [];
  
  if (bCard) {
    combined.push(...bCard.split('·').map(s => s.trim()));
  } else if (bHero) {
    combined.push(...bHero.split('·').map(s => s.trim()));
  }
  
  if (tags) combined.push(...(tags || []));

  const found = [];
  let hasMds = false;
  let hasHof = false;

  for (const t of combined) {
    const low = t.toLowerCase();
    
    // Milioni (Riconosce "Million Dollar" o il formato "$13M+")
    if (!hasMds && (low.includes('million dollar') || (low.includes('$') && low.includes('m+')))) {
      found.push({ type: 'mds', label: t.toUpperCase() });
      hasMds = true;
    }
    // Hall of Fame
    if (!hasHof && low.includes('hall of fame')) {
      found.push({ type: 'hof', label: t.toUpperCase() });
      hasHof = true;
    }
  }

  return found;
}

// Helper: slug pedigree per link
function pedLink(name, allSt) {
  if (!name) return null;
  const found = allSt.find(s => s.data.name.toLowerCase() === name.toLowerCase());
  if (!found) return null;
  return `${langPrefix}/stalloni/${found.id}`;
}
---
<Layout
  title={isEn ? "Stallion Database — Reining Factory" : "Database Stalloni Reining — Reining Factory"}
  description={isEn ? "The complete reining stallion database. Pedigrees, earnings and breeding info." : "Il database completo degli stalloni da reining. Pedigree, earnings e informazioni di monta."}
>

<!-- HERO -->
<section class="db-hero">
  <div class="db-hero-bg"></div>
  <div class="db-hero-content">
    <p class="db-eyebrow">{t('stalloni.db')}</p>
    <h1 class="db-title">
      <span>{t('stalloni.hero_title')} <em>{t('stalloni.hero_title_em')}</em></span>
    </h1>
    <p class="db-subtitle">{t('stalloni.hero_sub')}</p>
  </div>
</section>

<!-- FILTRI -->
<div class="db-filters-wrap" id="filtersWrap">
  <button class="db-mobile-filter-toggle" id="mobileFilterToggle">
    {t('stalloni.filter_search')}
    <svg class="db-mobile-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <div class="db-filters-content" id="mobileFiltersContent">
    <div class="db-filters">
    <!-- RICERCA -->
    <div class="db-search-box">
      <svg class="db-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input
        type="text"
        id="searchInput"
        class="db-search-input"
        placeholder={t('stalloni.search_placeholder')}
        autocomplete="off"
      />
      <button class="db-search-clear" id="searchClear" aria-label="Cancella ricerca">✕</button>
    </div>
    <!-- ORIGINE -->
    <div class="db-filter-group">
      <span class="db-filter-label">{t('stalloni.filter_origin')}</span>
      <div class="db-toggle-group">
        <button class="db-toggle active" data-origin="all">{t('stalloni.filter_all')}</button>
        <button class="db-toggle" data-origin="USA">USA</button>
        <button class="db-toggle" data-origin="EU">EU</button>
      </div>
    </div>
    <!-- ELITE -->
    <div class="db-filter-group">
      <span class="db-filter-label">Elite</span>
      <div class="db-toggle-group">
        <button class="db-elite" data-elite="hof" title="NRHA Hall of Fame">
          Hall of Fame
        </button>
        <button class="db-elite" data-elite="mds" title="Million Dollar Sire">
          Million Dollar Sire
        </button>
      </div>
    </div>
    <!-- FILTRI AVANZATI TOGGLE -->
    <button class="db-advanced-btn" id="advancedBtn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/>
      </svg>
      {t('stalloni.filter_advanced')}
      <span class="db-advanced-arrow" id="advancedArrow">▼</span>
    </button>
  </div>
  <!-- PANNELLO AVANZATO -->
  <div class="db-advanced-panel" id="advancedPanel">
    <div class="db-advanced-inner">
      <div class="db-adv-group">
        <label class="db-adv-label">{t('horse.earnings')}</label>
        <select class="db-adv-select" id="earningsSelect">
          <option value="">{t('stalloni.earning_all')}</option>
          <option value="<100k">&lt; $100.000</option>
          <option value=">100k">&gt; $100.000</option>
          <option value=">200k">&gt; $200.000</option>
          <option value=">300k">&gt; $300.000</option>
          <option value=">400k">&gt; $400.000</option>
          <option value=">500k">&gt; $500.000</option>
          <option value=">1m">&gt; $1.000.000</option>
        </select>
      </div>
      <div class="db-adv-group">
        <label class="db-adv-label">{isEn ? 'Coat Color' : 'Mantello'}</label>
        <select class="db-adv-select" id="colorSelect">
          <option value="">{t('stalloni.color_all')}</option>
          {uniqueColors.map(c => <option value={c}>{c}</option>)}
        </select>
      </div>
      <div class="db-adv-group">
        <label class="db-adv-label">{t('horse.semen')}</label>
        <select class="db-adv-select" id="semenSelect">
          <option value="">{t('stalloni.semen_all')}</option>
          {uniqueSemen.map(s => <option value={s}>{s.toUpperCase()}</option>)}
        </select>
      </div>
      <div class="db-adv-group">
        <label class="db-adv-label">{isEn ? 'Breeding Fee ($)' : 'Prezzo Seme ($)'}</label>
        <div class="db-range-wrap">
          <input type="number" class="db-adv-input" id="priceFrom" placeholder={isEn ? "From" : "Da"} />
          <span class="db-range-sep">—</span>
          <input type="number" class="db-adv-input" id="priceTo" placeholder={isEn ? "To" : "A"} />
        </div>
      </div>
      <div class="db-adv-group">
        <label class="db-adv-label">{isEn ? 'Birth Year' : 'Anno nascita'}</label>
        <div class="db-range-wrap">
          <input type="number" class="db-adv-input" id="yearFrom" placeholder={isEn ? "From" : "Dal"} min="1970" max="2025" />
          <span class="db-range-sep">—</span>
          <input type="number" class="db-adv-input" id="yearTo" placeholder={isEn ? "To" : "Al"} min="1970" max="2025" />
        </div>
      </div>
      <button class="db-reset-btn" id="resetBtn">
        {t('stalloni.reset_filters')}
      </button>
    </div>
  </div>
  </div>
  <!-- CONTATORE E VIEW TOGGLE -->
  <div class="db-results-bar">
    <div class="db-results-left">
      <span id="resultsCount" class="db-results-count"></span>
      <span class="db-disclaimer">({isEn ? 'database continuously updated' : 'database in continuo aggiornamento'})</span>
    </div>
    <div class="db-view-toggle">
      <button class="db-view-btn active" data-view="grid" title="Grid View">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
      </button>
      <button class="db-view-btn" data-view="list" title="List View">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
      </button>
    </div>
  </div>
</div>

<!-- GRIGLIA -->
<div class="db-grid-wrap">
  <div class="db-grid" id="stalloniGrid">
    {allStalloni.map((stallone, index) => {
      const h = stallone.data;
      const badges = getBadges(
        h.tags, 
        isEn ? (h.badge_card_en || h.badge_card) : h.badge_card, 
        isEn ? (h.badge_hero_en || h.badge_hero || h.badge_en) : (h.badge_hero || h.badge)
      );
      const semenStr = isEn ? (h.breeding?.semenType_en || h.breeding?.semenType || '') : (h.breeding?.semenType || '');
      const fee = typeof h.breeding?.fee === 'string' ? parseInt(h.breeding.fee.replace(/[^0-9]/g, '')) : (h.breeding?.fee || 0);
      const earningsRaw = h.stats?.earnings || '';
      let earningsNum = 0;
      const matchObj = earningsRaw.match(/[\d,.]+/);
      if (matchObj) {
        let n = parseFloat(matchObj[0].replace(/,/g, ''));
        const l = earningsRaw.toLowerCase();
        if (l.includes('k')) n *= 1000;
        if (l.includes('m') || l.includes('million')) n *= 1000000;
        earningsNum = n;
      }
      return (
        <a
          href={`${langPrefix}/stalloni/${stallone.id}`}
          class="db-card"
          style={`animation-delay: ${(index % 20) * 0.04}s`}
          data-name={(h.name || '').toLowerCase()}
          data-origin={(h.origine || '').toUpperCase()}
          data-color={((isEn ? (h.color_en || h.color) : h.color) || '').toLowerCase()}
          data-semen={semenStr.toLowerCase()}
          data-year={h.yearOfBirth || ''}
          data-price={fee}
          data-earnings={earningsNum}
          data-badges={badges.map(b => b.type).join(',')}
        >
          <div class="db-card-media">
            {(h.cardImage || h.mainImage)
              ? <img src={h.cardImage || h.mainImage} alt={h.name} loading="lazy" width="400" height="300" />
              : <div class="db-card-placeholder"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg></div>
            }
            <div class="db-badges-container">
              {badges.map(badge => (<div class={`db-badge db-badge-${badge.type}`}>{badge.label}</div>))}
            </div>
            {h.origine && <div class={`db-origin-tag db-origin-${(h.origine || '').toLowerCase()}`}>{h.origine}</div>}
          </div>
          <div class="db-card-body">
            <h3 class="db-card-name">{h.name}</h3>
            {(h.pedigree?.sire || h.pedigree?.dam) && (
              <p class="db-card-pedigree">
                {h.pedigree?.sire && <span class="db-ped-sire">{h.pedigree.sire}</span>}
                {h.pedigree?.sire && h.pedigree?.dam && <span class="db-ped-sep"> × </span>}
                {h.pedigree?.dam && <span class="db-ped-dam">{h.pedigree.dam}</span>}
              </p>
            )}
            <div class="db-card-footer">
              {h.yearOfBirth && (
                <div class="db-card-stat">
                  <span class="db-stat-label">{t('horse.born')}</span>
                  <span class="db-stat-value">{h.yearOfBirth}</span>
                </div>
              )}
              {h.stats?.earnings && (
                <div class="db-card-stat">
                  <span class="db-stat-label">LTE</span>
                  <span class="db-stat-value db-stat-gold">
                    {h.stats.earnings.endsWith('+') ? h.stats.earnings : `${h.stats.earnings}+`}
                  </span>
                </div>
              )}
            </div>
          </div>
        </a>
      );
    })}
  </div>
  <div class="db-empty" id="emptyState" style="display:none;">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
    <p class="db-empty-title">{t('stalloni.no_results')}</p>
    <p class="db-empty-sub">{t('stalloni.adjust_filters')}</p>
    <button class="db-reset-btn" id="emptyResetBtn">{t('stalloni.reset_filters')}</button>
  </div>
</div>

<script is:inline define:vars={{ isEn }}>
  function initFilters() {
    const mobileToggle = document.getElementById('mobileFilterToggle');
    const mobileContent = document.getElementById('mobileFiltersContent');
    if (mobileToggle && mobileContent) {
      // Rimuoviamo eventuali listener precedenti per evitare duplicati
      const newToggle = mobileToggle.cloneNode(true);
      mobileToggle.parentNode.replaceChild(newToggle, mobileToggle);
      newToggle.addEventListener('click', () => {
        newToggle.classList.toggle('open');
        mobileContent.classList.toggle('open');
      });
    }

    const searchInput = document.getElementById('searchInput');
    const originBtns = document.querySelectorAll('[data-origin]');
    const eliteBtns = document.querySelectorAll('[data-elite]');
    const colorSelect = document.getElementById('colorSelect');
    const semenSelect = document.getElementById('semenSelect');
    const earningsSelect = document.getElementById('earningsSelect');
    const yearFrom = document.getElementById('yearFrom');
    const yearTo = document.getElementById('yearTo');
    const priceFrom = document.getElementById('priceFrom');
    const priceTo = document.getElementById('priceTo');
    const grid = document.getElementById('stalloniGrid');
    const resultsCount = document.getElementById('resultsCount');
    const cards = Array.from(grid.querySelectorAll('.db-card'));
    const emptyState = document.getElementById('emptyState');

    // Sincronizziamo lo stato con i valori reali (importante per il tasto "Back")
    const state = {
      search: searchInput?.value.toLowerCase().trim() || '',
      origin: document.querySelector('[data-origin].active')?.dataset.origin || 'all',
      elite: document.querySelector('[data-elite].active')?.dataset.elite || null,
      color: colorSelect?.value || '',
      semen: semenSelect?.value || '',
      earnings: earningsSelect?.value || '',
      yearFrom: yearFrom?.value || '',
      yearTo: yearTo?.value || '',
      priceFrom: priceFrom?.value || '',
      priceTo: priceTo?.value || '',
    };

    function applyFilters() {
      let visible = 0;
      cards.forEach(card => {
        const cardText = card.textContent.toLowerCase();
        const origin = card.dataset.origin || '';
        const color = card.dataset.color || '';
        const semen = card.dataset.semen || '';
        const year = parseInt(card.dataset.year) || 0;
        const price = parseInt(card.dataset.price) || 0;
        const banners = card.dataset.badges ? card.dataset.badges.split(',') : [];
        const cardEarnings = parseInt(card.dataset.earnings) || 0;

        const searchOk = !state.search || cardText.includes(state.search);
        const originOk = state.origin === 'all' || origin === state.origin;
        const eliteOk = !state.elite || banners.includes(state.elite);
        const colorOk = !state.color || color === state.color.toLowerCase();
        const semenOk = !state.semen || semen.includes(state.semen.toLowerCase());
        
        let earningsOk = true;
        if (state.earnings === '<100k') earningsOk = cardEarnings > 0 && cardEarnings < 100000;
        else if (state.earnings === '>100k') earningsOk = cardEarnings > 100000;
        else if (state.earnings === '>200k') earningsOk = cardEarnings > 200000;
        else if (state.earnings === '>300k') earningsOk = cardEarnings > 300000;
        else if (state.earnings === '>400k') earningsOk = cardEarnings > 400000;
        else if (state.earnings === '>500k') earningsOk = cardEarnings > 500000;
        else if (state.earnings === '>1m') earningsOk = cardEarnings > 1000000;

        const yfOk = !state.yearFrom || year >= parseInt(state.yearFrom);
        const ytOk = !state.yearTo || year <= parseInt(state.yearTo);
        const pfOk = !state.priceFrom || price >= parseInt(state.priceFrom);
        const ptOk = !state.priceTo || (price > 0 && price <= parseInt(state.priceTo));

        if (searchOk && originOk && eliteOk && colorOk && semenOk && earningsOk && yfOk && ytOk && pfOk && ptOk) {
          card.style.display = ''; visible++;
        } else {
          card.style.display = 'none';
        }
      });

      if (resultsCount) {
        resultsCount.textContent = isEn 
          ? `${visible} stallion${visible !== 1 ? 's' : ''} found`
          : `${visible} stallon${visible !== 1 ? 'i' : 'e'} trovat${visible !== 1 ? 'i' : 'o'}`;
      }
      if (emptyState) emptyState.style.display = visible === 0 ? 'flex' : 'none';
    }

    // Event Listeners
    const searchClear = document.getElementById('searchClear');
    searchInput?.addEventListener('input', e => {
      state.search = e.target.value.toLowerCase().trim();
      searchClear?.classList.toggle('visible', e.target.value.length > 0);
      applyFilters();
    });
    searchClear?.addEventListener('click', () => {
      searchInput.value = '';
      state.search = '';
      searchClear.classList.remove('visible');
      applyFilters();
    });
    originBtns.forEach(btn => btn.addEventListener('click', () => {
      originBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      state.origin = btn.dataset.origin;
      applyFilters();
    }));
    eliteBtns.forEach(btn => btn.addEventListener('click', () => {
      const active = btn.classList.toggle('active');
      eliteBtns.forEach(b => { if(b !== btn) b.classList.remove('active'); });
      state.elite = active ? btn.dataset.elite : null;
      applyFilters();
    }));
    colorSelect?.addEventListener('change', e => { state.color = e.target.value; applyFilters(); });
    semenSelect?.addEventListener('change', e => { state.semen = e.target.value; applyFilters(); });
    earningsSelect?.addEventListener('change', e => { state.earnings = e.target.value; applyFilters(); });
    [yearFrom, yearTo, priceFrom, priceTo].forEach(el => el?.addEventListener('input', e => { state[el.id] = e.target.value; applyFilters(); }));

    const advancedBtn = document.getElementById('advancedBtn');
    const advancedPanel = document.getElementById('advancedPanel');
    const advancedArrow = document.getElementById('advancedArrow');
    advancedBtn?.addEventListener('click', () => {
      const open = advancedPanel.classList.toggle('open');
      if (advancedArrow) advancedArrow.textContent = open ? '▲' : '▼';
    });

    const resetBtn = document.getElementById('resetBtn');
    const emptyResetBtn = document.getElementById('emptyResetBtn');
    const handleReset = () => {
      state.search = ''; state.origin = 'all'; state.elite = null; state.color = ''; state.semen = '';
      state.earnings = ''; state.yearFrom = ''; state.yearTo = ''; state.priceFrom = ''; state.priceTo = '';
      [searchInput, colorSelect, semenSelect, earningsSelect, yearFrom, yearTo, priceFrom, priceTo].forEach(el => { if(el) el.value = ''; });
      searchClear?.classList.remove('visible');
      originBtns.forEach(b => b.classList.toggle('active', b.dataset.origin === 'all'));
      eliteBtns.forEach(b => b.classList.remove('active'));
      applyFilters();
    };
    resetBtn?.addEventListener('click', handleReset);
    emptyResetBtn?.addEventListener('click', handleReset);

    // Prima esecuzione
    applyFilters();
  }

  // Esegui all'avvio e ad ogni cambio pagina di Astro (incluso il tasto Back)
  document.addEventListener('astro:page-load', initFilters);
</script>

<script is:inline>
  function initView() {
    const viewBtns = document.querySelectorAll('.db-view-btn');
    const stalloniGrid = document.getElementById('stalloniGrid');
    const savedViewPref = localStorage.getItem('stalloniViewPref') || 'grid';
    
    if (savedViewPref === 'list' && stalloniGrid) {
      stalloniGrid.classList.add('view-list');
      const listBtn = document.querySelector('.db-view-btn[data-view="list"]');
      const gridBtn = document.querySelector('.db-view-btn[data-view="grid"]');
      if (listBtn) listBtn.classList.add('active');
      if (gridBtn) gridBtn.classList.remove('active');
    } else if (stalloniGrid) {
      stalloniGrid.classList.remove('view-list');
      const listBtn = document.querySelector('.db-view-btn[data-view="list"]');
      const gridBtn = document.querySelector('.db-view-btn[data-view="grid"]');
      if (listBtn) listBtn.classList.remove('active');
      if (gridBtn) gridBtn.classList.add('active');
    }

    viewBtns.forEach(btn => {
      // Rimuoviamo listener precedenti se presenti
      const newBtn = btn.cloneNode(true);
      btn.parentNode.replaceChild(newBtn, btn);
      
      newBtn.addEventListener('click', () => {
        document.querySelectorAll('.db-view-btn').forEach(b => b.classList.remove('active'));
        newBtn.classList.add('active');
        if (newBtn.dataset.view === 'list') {
          if(stalloniGrid) stalloniGrid.classList.add('view-list');
          localStorage.setItem('stalloniViewPref', 'list');
        } else {
          if(stalloniGrid) stalloniGrid.classList.remove('view-list');
          localStorage.setItem('stalloniViewPref', 'grid');
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initView);
</script>
</Layout>

<style is:global>
  /* CSS styles migrated from OLD.astro */
  :root {
    --db-gold: #C8973A; --db-gold-lt: #E8C068; --db-dark: #0D0B04; --db-dark2: #1A1610; 
    --db-dark3: #221A0A; --db-warm-gray: #9A9188; --db-border: rgba(200,151,58,0.18); --db-cream: #F5F0E8;
  }
  .db-hero { position: relative; min-height: 60vh; display: flex; align-items: flex-start; overflow: hidden; }
  .db-hero-bg { position: absolute; inset: 0; background: linear-gradient(135deg, rgba(13,11,4,0.88) 40%, rgba(107,76,42,0.35) 100%), url('/immagini/stalloni-hero.webp') center/cover no-repeat; }
