              <tr class="penalty-zero"><td>Score 0</td><td>0</td><td>{isEn ? "Improper use of the romal" : "Uso scorretto del romal"}</td></tr>
              <tr class="penalty-zero"><td>Score 0</td><td>0</td><td>{isEn ? "Failure to complete pattern as written" : "Pattern non completato come descritto"}</td></tr>
