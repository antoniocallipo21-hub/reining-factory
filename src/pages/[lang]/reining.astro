          <ul>
            <li>{isEn ? <Fragment>All riders must <strong>dismount</strong> immediately following the run</Fragment> : <Fragment>Tutti i cavalieri devono <strong>scendere da cavallo</strong> immediatamente dopo il percorso</Fragment>}</li>
            <li>{isEn ? <Fragment>Must <strong>drop the bridle</strong> immediately</Fragment> : <Fragment>Devono <strong>togliere l'imboccatura</strong> subito</Fragment>}</li>
            <li>{isEn ? <Fragment>Horse and equipment must be <strong>presented to the judge</strong> in the arena</Fragment> : <Fragment>Il cavallo e l'attrezzatura devono essere <strong>presentati al giudice</strong> in arena</Fragment>}</li>
            <li>{isEn ? <Fragment>Refusal to dismount or allow inspection = <strong>NO SCORE</strong></Fragment> : <Fragment>Rifiuto di scendere o far ispezionare = <strong>NO SCORE</strong></Fragment>}</li>
          </ul>
        </div>
        
       <div style="margin-top:2.5rem;display:flex;justify-content:center;">
