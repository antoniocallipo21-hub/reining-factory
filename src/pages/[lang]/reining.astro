              <tr><td>{isEn ? "Shirt" : "Camicia"}</td><td>{isEn ? "Long sleeved with collar, western style" : "A maniche lunghe, stile western"}</td><td>{isEn ? "YES" : "SÌ"}</td></tr>
              <tr><td>{isEn ? "Western Hat" : "Cappello Western"}</td><td>{isEn ? "Traditional western hat" : "Tradizionale cappello western"}</td><td>{isEn ? "YES (except under 18)" : "SÌ (eccetto under 18)"}</td></tr>
              <tr><td>{isEn ? "Safety Helmet" : "Caschetto Protettivo"}</td><td>{isEn ? "Approved riding helmet" : "Protezione omologata"}</td><td>{isEn ? "YES (mandatory under 18)" : "SÌ (obbligatorio under 18)"}</td></tr>
