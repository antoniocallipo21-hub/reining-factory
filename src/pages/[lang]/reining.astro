  <script is:inline>
    // Reveal script 
    document.addEventListener('astro:page-load', () => {
      // Setup Subnav scrollspy
      const navbar = document.getElementById('navbar') || document.querySelector('nav');
      const backTop = document.getElementById('backTop');

      window.addEventListener('scroll', () => {
        if (navbar) navbar.classList.toggle('scrolled', window.scrollY > 60);
        if (backTop) backTop.classList.toggle('visible', window.scrollY > 400);

        // Active subnav
        const sections = ['introduzione','categorie','pattern','punteggio','penalita','regolamento','eventi'];
        const links = document.querySelectorAll('.subnav a');
        if(links.length > 0) {
          let current = sections[0];
          sections.forEach(id => {
            const el = document.getElementById(id);
            if (el && el.getBoundingClientRect().top <= 300) current = id;
          });
          links.forEach(a => {
            a.classList.toggle('active', a.getAttribute('href') === '#' + current);
          });
        }
      });

      // Smooth scroll subnav items
      const subnavLinks = document.querySelectorAll('.subnav a');
      subnavLinks.forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = link.getAttribute('href').substring(1);
          const target = document.getElementById(targetId);
          if (target) {
            window.scrollTo({
              top: target.offsetTop - 260,
              behavior: 'smooth'
            });
          }
        });
      });

      // Observer per elementi con animazione "reveal"
      const obs = new IntersectionObserver(entries => {
        entries.forEach(e => { 
          if (e.isIntersecting) { 
            e.target.classList.add('visible'); 
            obs.unobserve(e.target); 
          } 
        });
      }, { threshold: 0.08 });
      
      document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
    });
  </script>
</Layout>
