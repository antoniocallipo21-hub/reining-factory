---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

export async function getStaticPaths() {
  return [
    { params: { lang: 'it' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang);
const isEn = lang === 'en';
const langPrefix = '/' + lang;
---

<Layout title={isEn ? "Contact | Reining Factory" : "Contatti | Reining Factory"}>
  
  <style>
    /* HERO */
    .page-hero {
      min-height: 60vh;
      position: relative;
      display: flex;
      align-items: flex-start;
      overflow: hidden;
      background: linear-gradient(to bottom, rgba(26,20,8,0.5) 0%, rgba(26,20,8,0.95) 100%), url('/immagini/contatti-hero.jpg') center/cover no-repeat;
    }
    .page-hero-content {
      position: relative;
      z-index: 2;
      padding: 150px 4rem 3rem 4rem;
      max-width: 900px;
    }
    .page-hero-eyebrow {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 0.8rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 1rem;
    }
    .page-hero-title {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2.5rem, 6vw, 5rem);
      font-weight: 900;
      line-height: 1;
      margin-bottom: 1rem;
    }
    .page-hero-title em {
      font-style: italic;
      color: var(--gold);
    }
    .page-hero-subtitle {
      font-size: 1.1rem;
      font-weight: 300;
      color: rgba(245,240,232,0.7);
      max-width: 500px;
      line-height: 1.75;
      font-family: inherit;
    }

    /* CONTENT */
    .content-wrap {
      max-width: 1100px;
      margin: 0 auto;
      padding: 5rem 4rem;
      font-family: 'Barlow', sans-serif;
    }

    /* GRID CONTATTI */
    .contatti-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
    }

    /* COLONNA SINISTRA — info */
    .info-block {
      margin-bottom: 2.5rem;
    }
    .info-block-label {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 0.72rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 0.8rem;
    }
    .info-block-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.4rem;
      font-weight: 700;
      margin-bottom: 0.6rem;
    }
    .info-block p {
      color: rgba(245,240,232,0.6);
      line-height: 1.8;
      font-size: 0.95rem;
    }

    .email-link {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      color: rgba(245,240,232,0.6);
      text-decoration: none;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 0.95rem;
      letter-spacing: 0.05em;
      border-bottom: 1px solid rgba(201,150,58,0.3);
      padding-bottom: 2px;
      transition: all 0.3s;
      margin-top: 0.5rem;
    }
    .email-link:hover {
      color: var(--gold);
      border-bottom-color: var(--gold);
    }

    .social-links {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
      margin-top: 1rem;
    }
    .social-link {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      color: rgba(245,240,232,0.6);
      text-decoration: none;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 0.95rem;
      letter-spacing: 0.05em;
      transition: color 0.3s;
    }
    .social-link:hover {
      color: var(--gold);
    }

    .divider {
      border: none;
      border-top: 1px solid var(--border);
      margin: 2.5rem 0;
    }

    /* FORM */
    .form-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.4rem;
      font-weight: 700;
      margin-bottom: 1.8rem;
    }
    .form-group {
      margin-bottom: 1.4rem;
    }
    .form-group label {
      display: block;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 0.72rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(245,240,232,0.5);
      margin-bottom: 0.5rem;
    }
    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      background: rgba(255,255,255,0.04);
      border: 1px solid var(--border);
      color: var(--cream);
      font-family: 'Barlow', sans-serif;
      font-size: 0.95rem;
      font-weight: 300;
      padding: 0.85rem 1rem;
      outline: none;
      transition: border-color 0.3s;
      appearance: none;
      border-radius: 0;
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: rgba(201,150,58,0.5);
    }
    .form-group textarea {
      resize: vertical;
      min-height: 140px;
      line-height: 1.7;
    }
    .form-group select option {
      background: #1a1408;
      color: var(--cream);
    }

    .form-submit {
      width: 100%;
      background: var(--gold);
      color: var(--dark);
      border: none;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 0.82rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      font-weight: 700;
      padding: 1rem 2rem;
      cursor: pointer;
      transition: background 0.3s;
      position: relative;
      overflow: hidden;
    }
    .form-submit:hover {
      background: var(--gold-light);
    }
    .form-submit:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    /* FEEDBACK MESSAGGI */
    .form-feedback {
      display: none;
      padding: 1rem 1.2rem;
      margin-top: 1rem;
      font-size: 0.9rem;
      font-family: 'Barlow', sans-serif;
    }
    .form-feedback.success {
      background: rgba(80,180,100,0.1);
      border: 1px solid rgba(80,180,100,0.3);
      color: #80e090;
    }
    .form-feedback.error {
      background: rgba(220,80,60,0.1);
      border: 1px solid rgba(220,80,60,0.3);
      color: #ff9080;
    }

    /* NOTE RIMOZ IMMAGINI */
    .note-box {
      background: rgba(201,150,58,0.06);
      border: 1px solid var(--border);
      border-left: 4px solid var(--gold);
      padding: 1.5rem 1.8rem;
      margin-top: 3rem;
    }
    .note-box-label {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 0.7rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 0.6rem;
    }
    .note-box p {
      font-size: 0.88rem;
      color: rgba(245,240,232,0.55);
      line-height: 1.8;
    }

    /* REVEAL */
    .reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }
    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* RESPONSIVE */
    @media(max-width:1024px) {
      .page-hero-content { padding: 150px 2rem 3rem 2rem; }
      .content-wrap { padding: 4rem 2rem; }
    }
    @media (max-width: 768px) {
      .page-hero-content { padding: 140px 1.5rem 1rem; }
      .page-hero-subtitle { font-size: 0.95rem; }
      .content-wrap { padding: 2.5rem 1.5rem; }
      .contatti-grid { grid-template-columns: 1fr; gap: 3rem; }
    }
  </style>

  <!-- HERO -->
  <div class="page-hero">
    <div class="page-hero-content">
      <p class="page-hero-eyebrow">{t('contact.hero_eyebrow')}</p>
      <h1 class="page-hero-title"><em>{t('contact.hero_title')}</em></h1>
      <p class="page-hero-subtitle">{t('contact.hero_sub')}</p>
    </div>
  </div>

  <!-- CONTENT -->
  <div class="content-wrap">
    <div class="contatti-grid reveal">

      <!-- COLONNA SINISTRA -->
      <div class="contatti-info">

        <div class="info-block">
          <div class="info-block-label">{t('contact.info_email_label')}</div>
          <p>{t('contact.info_email_p')}</p>
          <a href="mailto:reiningfactory.info@gmail.com" class="email-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="2,4 12,13 22,4"/></svg>
            reiningfactory.info@gmail.com
          </a>
        </div>

        <hr class="divider"/>

        <div class="info-block">
          <div class="info-block-label">{t('contact.info_social_label')}</div>
          <p>{t('contact.info_social_p')}</p>
          <div class="social-links">
            <a href="https://www.instagram.com/reiningfactory" target="_blank" rel="noopener" class="social-link">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/></svg>
              @reiningfactory {isEn ? 'on' : 'su'} Instagram
            </a>
            <a href="https://www.facebook.com/reiningfactory" target="_blank" rel="noopener" class="social-link">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              @reiningfactory {isEn ? 'on' : 'su'} Facebook
            </a>
            <a href="https://www.tiktok.com/@reiningfactory" target="_blank" rel="noopener" class="social-link">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
                <g transform="scale(0.8) translate(3,3)">
                  <path d="M12.53.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 2.22-1.15 4.31-2.92 5.56-1.74 1.25-4.04 1.65-6.07 1.07-2.11-.58-3.9-2.07-4.82-4.05-1.01-2.04-1-4.49.02-6.53 1.02-2.06 2.9-3.57 5.09-4.14.36-.1.73-.17 1.11-.21v4.06c-1.37.14-2.61.9-3.32 2.06-.7 1.15-.79 2.62-.23 3.84.55 1.22 1.71 2.06 3.01 2.22 1.34.17 2.69-.37 3.55-1.41.86-1.02 1.29-2.36 1.29-3.69-.02-5.74-.01-11.49-.01-17.23z"/>
                </g>
              </svg>
              @reiningfactory {isEn ? 'on' : 'su'} TikTok
            </a>
          </div>
        </div>

        <hr class="divider"/>

        <div class="info-block">
          <div class="info-block-label">{t('contact.info_topics_label')}</div>
          <p>{t('contact.info_topics_p')}</p>
          <ul style="margin-top:0.8rem;margin-left:1.2rem;color:rgba(245,240,232,0.55);font-size:0.9rem;line-height:2;">
            <li>{t('contact.info_topics_li1')}</li>
            <li>{t('contact.info_topics_li2')}</li>
            <li>{t('contact.info_topics_li3')}</li>
            <li>{t('contact.info_topics_li4')}</li>
            <li>{t('contact.info_topics_li5')}</li>
          </ul>
        </div>

        <div class="note-box">
          <div class="note-box-label">{t('contact.note_title')}</div>
          <p>{t('contact.note_p')}</p>
        </div>

      </div>

      <!-- COLONNA DESTRA — FORM -->
      <div class="contatti-form">
        <p class="form-title">{t('contact.form_title')}</p>

        <form id="contactForm" action="https://formspree.io/f/mjgarddb" method="POST">

          <div class="form-group">
            <label for="nome">{t('contact.form_name')}</label>
            <input type="text" id="nome" name="nome" placeholder={t('contact.form_name_ph')} required/>
          </div>

          <div class="form-group">
            <label for="email">{t('contact.form_email')}</label>
            <input type="email" id="email" name="email" placeholder={t('contact.form_email_ph')} required/>
          </div>

          <div class="form-group">
            <label for="oggetto">{t('contact.form_subject')}</label>
            <select id="oggetto" name="oggetto" required>
              <option value="" disabled selected>{t('contact.form_subject_ph')}</option>
              <option value="Correzione dati">{t('contact.subject.data')}</option>
              <option value="Aggiornamento informazioni">{t('contact.subject.update')}</option>
              <option value="Proposta contenuto">{t('contact.subject.content')}</option>
              <option value="Rimozione immagine">{t('contact.subject.remove')}</option>
              <option value="Collaborazione">{t('contact.subject.collab')}</option>
              <option value="Altro">{t('contact.subject.other')}</option>
            </select>
          </div>

          <div class="form-group">
            <label for="messaggio">{t('contact.form_msg')}</label>
            <textarea id="messaggio" name="messaggio" placeholder={t('contact.form_msg_ph')} required></textarea>
          </div>

          <button type="submit" class="form-submit" id="submitBtn">{t('contact.form_submit')}</button>

          <div class="form-feedback success" id="feedbackSuccess">
            {t('contact.form_success')}
          </div>
          <div class="form-feedback error" id="feedbackError">
            {t('contact.form_error')}
          </div>

        </form>
      </div>

    </div>
  </div>

  <script is:inline define:vars={{ sendingText: t('contact.form_sending'), submitText: t('contact.form_submit') }}>
    document.addEventListener('astro:page-load', () => {
      // Intersection Observer per animazioni scroll
      const obs = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if(e.isIntersecting) {
            e.target.classList.add('visible');
            obs.unobserve(e.target);
          }
        });
      }, {threshold: 0.12});
      document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

      // FORM — gestione invio asincrono con Formspree
      const form = document.getElementById('contactForm');
      const btn = document.getElementById('submitBtn');
      const ok = document.getElementById('feedbackSuccess');
      const err = document.getElementById('feedbackError');

      if (form) {
        form.addEventListener('submit', async function(e){
          e.preventDefault();
          btn.disabled = true;
          btn.textContent = sendingText;
          ok.style.display = 'none';
          err.style.display = 'none';
          
          try {
            const res = await fetch(form.action, {
              method: 'POST',
              body: new FormData(form),
              headers: { 'Accept': 'application/json' }
            });
            if(res.ok) {
              ok.style.display = 'block';
              form.reset();
            } else {
              err.style.display = 'block';
            }
          } catch(e) {
            err.style.display = 'block';
          }
          
          btn.disabled = false;
          btn.textContent = submitText;
        });
      }
    });
  </script>
</Layout>
